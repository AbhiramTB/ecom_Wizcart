<%- include('../layout/header') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
  .wz-product-page {
    padding: var(--wz-space-8) 0;
  }
  .wz-product-gallery {
    position: relative;
  }
  .wz-product-main-img {
    width: 100%;
    border-radius: var(--wz-radius-lg);
    overflow: hidden;
    background: var(--wz-gray-100);
    margin-bottom: var(--wz-space-4);
    position: relative;
    cursor: crosshair;
  }
  .wz-product-main-img img {
    width: 100%;
    height: 450px;
    object-fit: contain;
    display: block;
    transition: opacity 0.2s;
  }
  .wz-product-main-img.zooming img {
    opacity: 0;
  }
  .wz-product-main-img.zooming {
    background-repeat: no-repeat;
    background-size: 250%;
  }
  @media (max-width: 991px) {
    .wz-product-main-img { cursor: default; }
    .wz-product-main-img.zooming img { opacity: 1; }
    .wz-product-main-img.zooming { background-image: none !important; }
  }
  .wz-product-thumbs {
    display: flex;
    gap: var(--wz-space-3);
    overflow-x: auto;
    padding-bottom: var(--wz-space-2);
  }
  .wz-product-thumb {
    width: 80px;
    height: 80px;
    border-radius: var(--wz-radius-md);
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s;
    flex-shrink: 0;
    background: var(--wz-gray-100);
  }
  .wz-product-thumb.active,
  .wz-product-thumb:hover {
    border-color: var(--wz-accent);
  }
  .wz-product-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .wz-product-info {
    padding-left: var(--wz-space-6);
  }
  .wz-product-name {
    font-size: var(--wz-fs-2xl);
    font-weight: var(--wz-fw-bold);
    margin-bottom: var(--wz-space-3);
  }
  .wz-product-price-block {
    display: flex;
    align-items: baseline;
    gap: var(--wz-space-3);
    margin-bottom: var(--wz-space-4);
    flex-wrap: wrap;
  }
  .wz-product-price {
    font-size: 1.75rem;
    font-weight: var(--wz-fw-bold);
    color: var(--wz-text-primary);
  }
  .wz-product-mrp {
    font-size: var(--wz-fs-lg);
    color: var(--wz-gray-500);
    text-decoration: line-through;
  }
  .wz-product-discount {
    font-size: var(--wz-fs-sm);
    font-weight: var(--wz-fw-semibold);
    color: var(--wz-success);
    background: rgba(16, 185, 129, 0.1);
    padding: 2px 10px;
    border-radius: var(--wz-radius-full);
  }
  .wz-product-stock {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--wz-fs-sm);
    font-weight: var(--wz-fw-medium);
    margin-bottom: var(--wz-space-4);
    padding: 4px 12px;
    border-radius: var(--wz-radius-full);
  }
  .wz-stock-in {
    color: var(--wz-success);
    background: rgba(16, 185, 129, 0.1);
  }
  .wz-stock-out {
    color: var(--wz-danger);
    background: rgba(239, 68, 68, 0.1);
  }
  .wz-product-desc {
    font-size: var(--wz-fs-sm);
    color: var(--wz-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--wz-space-6);
  }
  .wz-product-actions {
    display: flex;
    gap: var(--wz-space-3);
    flex-wrap: wrap;
    margin-bottom: var(--wz-space-5);
  }
  .wz-btn-addcart {
    flex: 1;
    min-width: 160px;
    padding: var(--wz-space-3) var(--wz-space-6);
    background: var(--wz-accent);
    color: var(--wz-white);
    border: none;
    border-radius: var(--wz-radius-full);
    font-size: var(--wz-fs-base);
    font-weight: var(--wz-fw-semibold);
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .wz-btn-addcart:hover { background: var(--wz-accent-dark, #d63851); transform: translateY(-1px); }
  .wz-btn-wishlist {
    padding: var(--wz-space-3) var(--wz-space-5);
    background: transparent;
    color: var(--wz-text-primary);
    border: 1.5px solid var(--wz-gray-300);
    border-radius: var(--wz-radius-full);
    font-size: var(--wz-fs-base);
    font-weight: var(--wz-fw-medium);
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .wz-btn-wishlist:hover { border-color: var(--wz-accent); color: var(--wz-accent); }
  .wz-btn-wishlist.active { background: var(--wz-accent); color: var(--wz-white); border-color: var(--wz-accent); }
  .wz-btn-gotocart {
    width: 100%;
    padding: var(--wz-space-3) var(--wz-space-6);
    background: var(--wz-primary);
    color: var(--wz-white);
    border: none;
    border-radius: var(--wz-radius-full);
    font-size: var(--wz-fs-base);
    font-weight: var(--wz-fw-semibold);
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .wz-btn-gotocart:hover { opacity: 0.9; color: var(--wz-white); }
  .wz-product-meta {
    border-top: 1px solid var(--wz-gray-200);
    padding-top: var(--wz-space-4);
    font-size: var(--wz-fs-sm);
    color: var(--wz-text-secondary);
  }
  .wz-product-meta span { font-weight: var(--wz-fw-medium); color: var(--wz-text-primary); }
  @media (max-width: 767px) {
    .wz-product-info { padding-left: 0; margin-top: var(--wz-space-6); }
    .wz-product-main-img img { height: 300px; }
    .wz-product-name { font-size: var(--wz-fs-xl); }
  }
</style>

<div id="page">
  <%- include('../layout/navbar') %>

  <div class="breadcrumbs">
    <div class="container">
      <div class="row">
        <div class="col">
          <p class="bread"><span><a href="/home">Home</a></span> / <span><a href="/shopmore">Shop</a></span> / <span><%= singleProduct.product_name %></span></p>
        </div>
      </div>
    </div>
  </div>

  <div class="wz-product-page">
    <div class="container">
      <div class="row">
        <div class="col-md-6">
          <div class="wz-product-gallery" style="position: relative;">
            <% if (singleProduct.Maximum_Retail_Price && singleProduct.Maximum_Retail_Price > singleProduct.price) { %>
              <% var discountPercentage = ((singleProduct.Maximum_Retail_Price - singleProduct.price) / singleProduct.Maximum_Retail_Price) * 100; %>
              <span class="wz-offer-badge"><%= discountPercentage.toFixed(0) %>% OFF</span>
            <% } %>
            <div class="wz-product-main-img" id="mainImageWrap">
              <img src="<%= (singleProduct.product_img[0].startsWith('http://') || singleProduct.product_img[0].startsWith('https://') || singleProduct.product_img[0].startsWith('//')) ? singleProduct.product_img[0] : '/' + singleProduct.product_img[0] %>" alt="<%= singleProduct.product_name %>" id="mainImage">
            </div>
            <% if (singleProduct.product_img.length > 1) { %>
              <div class="wz-product-thumbs">
             <% singleProduct.product_img.forEach((img, index) => { %>
  <div class="wz-product-thumb <%= index === 0 ? 'active' : '' %>"
       onclick="changeImage('<%= img %>', this)">
    <img src="<%= img %>" alt="Product image <%= index + 1 %>">
       </div>
<% }) %>
              </div>
            <% } %>
          </div>
        </div>

        <div class="col-md-6">
          <div class="wz-product-info">
            <h1 class="wz-product-name"><%= singleProduct.product_name %></h1>

            <div class="wz-product-price-block">
              <span class="wz-product-price">₹<%= singleProduct.price %></span>
              <%
                var difference = singleProduct.Maximum_Retail_Price - singleProduct.price;
                var discountPercentage = (difference / singleProduct.Maximum_Retail_Price) * 100;
              %>  
              <% if (difference > 0) { %>
                <span class="wz-product-mrp">₹<%= singleProduct.Maximum_Retail_Price %></span>
                <span class="wz-offer-badge-inline"><%= discountPercentage.toFixed(0) %>% OFF</span>
              <% } %>
            </div>

            <% if (singleProduct.in_stock > 0) { %>
              <div class="wz-product-stock wz-stock-in">
                <i class="fas fa-check-circle"></i> In Stock (<%= singleProduct.in_stock %> available)
              </div>
            <% } else { %>
              <div class="wz-product-stock wz-stock-out">
                <i class="fas fa-times-circle"></i> Out of Stock
              </div>
            <% } %>

            <% if (singleProduct.product_description) { %>
              <p class="wz-product-desc"><%= singleProduct.product_description %></p>
            <% } else if (singleProduct.product_discription) { %>
              <p class="wz-product-desc"><%= singleProduct.product_discription %></p>
            <% } %>

            <input type="hidden" id="priceInput" value="<%= singleProduct.price %>">
            <input type="hidden" id="hiddenProductId" value="<%= singleProduct._id %>">
            <input type="hidden" id="wishlist_id" value="<%= singleProduct._id %>">
            <input type="hidden" id="quantity" value="1">

            <div class="wz-product-actions" id="addToCartButton" style="<%= isCartexist === 1 ? 'display:none' : '' %>">
              <button class="wz-btn-addcart" onclick="addtoCart()">
                <i class="fas fa-shopping-bag"></i> Add to Cart
              </button>
              <% if (!existingWishlist) { %>
                <button class="wz-btn-wishlist" id="wishListBTN" onclick="addtoWishlist()">
                  <i class="fa-regular fa-heart"></i> Wishlist
                </button>
              <% } else { %>
                <button class="wz-btn-wishlist active" disabled>
                  <i class="fa-solid fa-heart"></i> In Wishlist
                </button>
              <% } %>
            </div>

            <div id="goToCartContainer" style="<%= isCartexist === 1 ? '' : 'display:none' %>">
              <a href="/cart" class="wz-btn-gotocart">
                <i class="fas fa-shopping-bag"></i> Go to Cart
              </a>
            </div>

            <div id="afterClick" style="display:none;">
              <button class="wz-btn-wishlist active" disabled>
                <i class="fa-solid fa-heart"></i> Added to Wishlist
              </button>
            </div>

            <div class="wz-product-meta">
              <% if (singleProduct.category_name) { %>
                <p>Category: <span><%= (singleProduct.category_name && singleProduct.category_name.category_name) ? singleProduct.category_name.category_name : singleProduct.category_name %></span></p>
              <% } else if (singleProduct.category) { %>
                <p>Category: <span><%= singleProduct.category %></span></p>
              <% } %>
              <% if (singleProduct.brands) { %>
                <p>Brand: <span><%= singleProduct.brands %></span></p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Reviews Section -->
      <div class="row mt-5">
        <div class="col-12">
          <hr style="border-top: 1px solid var(--wz-gray-200); margin-bottom: 2rem;">
          <h3 class="mb-4" style="font-weight: var(--wz-fw-semibold); color: var(--wz-text-primary);">Customer Reviews</h3>
          
          <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
            <div class="wz-reviews-list">
              <% reviews.forEach(review => { %>
                <div class="wz-review-item p-3 mb-3" style="background: var(--wz-gray-50); border-radius: var(--wz-radius-md); border-left: 4px solid var(--wz-accent);">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span style="font-weight: var(--wz-fw-semibold); color: var(--wz-text-primary);">
                      <%= (review.userId && review.userId.name) ? review.userId.name : 'Verified Customer' %>
                    </span>
                    <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString() %></small>
                  </div>
                  <p class="mb-0 text-secondary" style="font-size: var(--wz-fs-sm); line-height: 1.6;"><%= review.userReview %></p>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="p-4 text-center rounded" style="background: var(--wz-gray-50); border: 1px dashed var(--wz-gray-300);">
              <i class="far fa-comments mb-2" style="font-size: 2rem; color: var(--wz-gray-400);"></i>
              <p class="mb-0 text-muted">No reviews yet for this product. Be the first to review it after purchase!</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../layout/siteFooter') %>
</div>

<%- include('../layout/toast') %>

<script>
  function changeImage(src, thumb) {
    document.getElementById('mainImage').src = src;
    document.querySelectorAll('.wz-product-thumb').forEach(t => t.classList.remove('active'));
    thumb.classList.add('active');
  }

  (function() {
    const wrap = document.getElementById('mainImageWrap');
    const img = document.getElementById('mainImage');
    if (!wrap || !img) return;

    wrap.addEventListener('mouseenter', function() {
      wrap.classList.add('zooming');
      wrap.style.backgroundImage = 'url(' + img.src + ')';
    });

    wrap.addEventListener('mouseleave', function() {
      wrap.classList.remove('zooming');
      wrap.style.backgroundImage = '';
    });

    wrap.addEventListener('mousemove', function(e) {
      const rect = wrap.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      wrap.style.backgroundPosition = x + '% ' + y + '%';
    });
  })();



  function addtoWishlist() {
    const productId = document.getElementById('wishlist_id').value;
    const button = document.getElementById('wishListBTN');
    if (!productId) { alert('Product ID is missing'); return; }
    button.style.display = 'none';
    document.getElementById('afterClick').style.display = 'block';
    button.style.pointerEvents = 'none';
    fetch('/addtowishlist', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId: productId })
    })
    .then(response => response.json())
    .then(data => { console.log('Success:', data); })
    .catch(error => {
      console.error('Error:', error);
      button.innerHTML = '<i class="fa-regular fa-heart"></i> Wishlist';
      button.style.display = '';
      document.getElementById('afterClick').style.display = 'none';
      button.style.pointerEvents = 'auto';
    });
  }

  function addtoCart() {
    const stock = <%= singleProduct.in_stock %>;
    if (stock === 0) {
      Swal.mixin({
        toast: true, position: 'bottom', showConfirmButton: false, timer: 7000,
        timerProgressBar: true, background: '#dc3545', color: 'white'
      }).fire({ icon: 'error', title: 'Product out of stock', text: 'We apologize for the inconvenience.' });
      return;
    }
    const quantity = document.getElementById('quantity').value;
    const productId = document.getElementById('hiddenProductId').value;
    const price = document.getElementById('priceInput').value;
    document.getElementById('addToCartButton').style.display = 'none';
    document.getElementById('goToCartContainer').style.display = 'block';
    Swal.mixin({
      toast: true, position: 'bottom', showConfirmButton: false, timer: 1500, timerProgressBar: true
    }).fire({ icon: 'success', title: 'Successfully added item to cart' });
    window.location.href = `/addtocart?productId=${productId}&quantity=${quantity}&price=${quantity * price}`;
  }

  window.onload = function() {
    const isCartExist = '<%= isCartexist %>';
    if (isCartExist === '1') {
      document.getElementById('addToCartButton').style.display = 'none';
      document.getElementById('goToCartContainer').style.display = 'block';
    }
  };
</script>

<%- include('../layout/footer') %>
