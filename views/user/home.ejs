<%- include('../layout/header') %>

<div id="page">
  <%- include('../layout/navbar') %>

  <aside id="colorlib-hero">
    <div class="flexslider mt-1">
      <ul class="slides">
        <li style="background-image: url(images/img_bg_1.jpg);">
          <div class="overlay"></div>
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6 offset-sm-3 text-center slider-text">
                <div class="slider-text-inner">
                  <div class="desc">
                    <h1 class="head-1"></h1>
                    <h2 class="head-2"></h2>
                    <h2 class="head-3"></h2>
                    <p class="category"><span></span></p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </li>
        <li style="background-image: url(images/img_bg_2.jpg);">
          <div class="overlay"></div>
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6 offset-sm-3 text-center slider-text">
                <div class="slider-text-inner">
                  <div class="desc"></div>
                </div>
              </div>
            </div>
          </div>
        </li>

          
        <li style="background-image: url(images/img_bg_3.jpg);">
          <div class="overlay"></div>
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6 offset-sm-3 text-center slider-text">
                <div class="slider-text-inner">
                  <div class="desc"></div>
                </div>
              </div>
            </div>
          </div>
        </li>


          <li style="background-image: url(images/img_bg_4.jpg);">
          <div class="overlay"></div>
          <div class="container-fluid">
            <div class="row">
              <div class="col-sm-6 offset-sm-3 text-center slider-text">
                <div class="slider-text-inner">
                  <div class="desc"></div>
                </div>
              </div>
            </div>
          </div>
        </li>


      </ul>
    </div>
  </aside>

  <div class="colorlib-intro">
    <div class="container">
      <div class="row">
        <div class="col-sm-12 text-center">
          <h2 class="intro">"Your Next Upgrade Awaits: Discover Top Mobiles at Unbeatable Prices!"</h2>
        </div>
      </div>
    </div>
  </div>



  <div class="colorlib-product">
    <div class="container">
      <div class="row">
        <div class="col-sm-8 offset-sm-2 text-center colorlib-heading">
          <h2>Best Sellers</h2>
        </div>
      </div>
      <div class="row row-pb-md">
        <% products.forEach(element => { %>
          <% if (element.Hide_product === 0) { %>
            <div class="col-lg-3 mb-4 text-center">
              <div class="product-entry border">
                <a href="/singleProduct/<%= element.id %>" class="prod-img">
                  <img src="<%= element.product_img[0] %>" class="img-fluid" alt="<%= element.product_name %>">
                </a>
                <div class="desc">
                  <h2><a href="/singleProduct/<%= element.id %>"><%= element.product_name %></a></h2>
                  <span class="price">₹<%= element.price %></span>
                </div>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
      <div class="row">
        <div class="col-md-12 text-center">
          <p><a href="/shopmore" class="btn btn-primary btn-lg">Shop All Products</a></p>
        </div>
      </div>
    </div>
  </div>

 

  <%- include('../layout/siteFooter') %>
</div>

<%- include('../layout/toast') %>

<%- include('../layout/footer') %>