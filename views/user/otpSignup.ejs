<%- include('../layout/header') %>

<style>
  .wz-auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--wz-primary) 0%, var(--wz-primary-light) 50%, var(--wz-secondary) 100%);
    padding: var(--wz-space-4);
  }
  .wz-auth-card {
    background: var(--wz-white);
    border-radius: var(--wz-radius-xl);
    box-shadow: var(--wz-shadow-2xl);
    overflow: hidden;
    max-width: 860px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
  }
  .wz-auth-brand {
    background: var(--wz-primary);
    color: var(--wz-white);
    padding: var(--wz-space-10);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .wz-auth-brand i { font-size: 3rem; color: var(--wz-accent); margin-bottom: var(--wz-space-4); }
  .wz-auth-brand h2 { font-size: var(--wz-fs-2xl); margin-bottom: var(--wz-space-3); color: var(--wz-white); }
  .wz-auth-form { padding: var(--wz-space-8); }
  .wz-auth-form h2 { font-size: var(--wz-fs-xl); margin-bottom: var(--wz-space-6); }
  .otp-input-group { display: flex; gap: var(--wz-space-2); justify-content: center; margin-bottom: var(--wz-space-4); }
  .otp-input {
    width: 48px; height: 56px; text-align: center; font-size: var(--wz-fs-xl); font-weight: var(--wz-fw-bold);
    border: 2px solid var(--wz-gray-300); border-radius: var(--wz-radius-md);
    transition: all 0.2s; outline: none;
  }
  .otp-input:focus { border-color: var(--wz-accent); box-shadow: 0 0 0 3px rgba(233,69,96,0.1); }
  .otp-input.is-valid { border-color: var(--wz-success); }
  .otp-input.is-invalid { border-color: var(--wz-danger); }
  @media (max-width: 767px) {
    .wz-auth-card { grid-template-columns: 1fr; }
    .wz-auth-brand { padding: var(--wz-space-6); }
    .wz-auth-form { padding: var(--wz-space-6); }
    .otp-input { width: 40px; height: 48px; font-size: var(--wz-fs-lg); }
  }
</style>

<div class="wz-auth-page">
  <div class="wz-auth-card">
    <div class="wz-auth-brand">
      <img src="../images/logo.png" alt="Logo" style="width: 180px; height: 60px; object-fit: contain; margin-bottom: var(--wz-space-4);">
      <p style="color: var(--wz-gray-400); font-size: var(--wz-fs-sm);">Enter the 6-digit OTP sent to your email</p>
    </div>
    <div class="wz-auth-form">
      <h2>Verify Your Email</h2>
      <% if (typeof(message) !== 'undefined') { %>
        <div style="background: var(--wz-danger-bg); border: 1px solid #f5c6cb; color: #721c24; padding: var(--wz-space-3); border-radius: var(--wz-radius-md); margin-bottom: var(--wz-space-4); text-align: center; font-size: var(--wz-fs-sm);"><%= message %></div>
      <% } %>
      <form id="SignUpForm" action="/otpData" method="post" onsubmit="return validateForm()">
        <div class="otp-input-group">
          <input type="text" class="otp-input" name="otp" id="otp1" maxlength="1" onkeyup="moveToNext(this, 'otp2')" required>
          <input type="text" class="otp-input" name="otp" id="otp2" maxlength="1" onkeyup="moveToNext(this, 'otp3')" required>
          <input type="text" class="otp-input" name="otp" id="otp3" maxlength="1" onkeyup="moveToNext(this, 'otp4')" required>
          <input type="text" class="otp-input" name="otp" id="otp4" maxlength="1" onkeyup="moveToNext(this, 'otp5')" required>
          <input type="text" class="otp-input" name="otp" id="otp5" maxlength="1" onkeyup="moveToNext(this, 'otp6')" required>
          <input type="text" class="otp-input" name="otp" id="otp6" maxlength="1" onkeyup="moveToNext(this, null)" required>
        </div>
        <div id="errmesg-otp" style="color: var(--wz-danger); font-size: var(--wz-fs-xs); text-align: center; min-height: 18px;"></div>
        <p id="otpExpirationMessage" style="color: var(--wz-accent); text-align: center; font-size: var(--wz-fs-sm); margin: var(--wz-space-3) 0;"></p>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--wz-space-4);">
          <p style="font-size: var(--wz-fs-sm); margin: 0;">Already have an account? <a href="/login" style="color: var(--wz-accent); font-weight: var(--wz-fw-semibold);">Login</a></p>
          <a href="/signupOtp" class="wz-btn wz-btn-outline wz-btn-sm" id="resendBtn" style="display: none;">Resend OTP</a>
        </div>
        <button type="submit" class="wz-btn wz-btn-primary wz-btn-block wz-btn-lg">Verify & Sign Up</button>
      </form>
    </div>
  </div>
</div>

<%- include('../layout/toast') %>

<script>
  function moveToNext(current, nextFieldID) {
    if (current.value.length === current.maxLength) {
      if (nextFieldID) document.getElementById(nextFieldID).focus();
      else current.blur();
    }
  }

  let otpExpirationTime = 60;
  let resendCooldownTime = 60;
  let resendCooldownInterval;
  let countdownInterval;

  function startResendCooldown() {
    let secondsLeft = localStorage.getItem('cooldownSecondsLeft') || resendCooldownTime;
    document.getElementById('resendBtn').style.display = 'none';
    if (resendCooldownInterval) clearInterval(resendCooldownInterval);
    resendCooldownInterval = setInterval(() => {
      secondsLeft--;
      localStorage.setItem('cooldownSecondsLeft', secondsLeft);
      if (secondsLeft <= 0) {
        clearInterval(resendCooldownInterval);
        document.getElementById('resendBtn').style.display = 'inline-flex';
        localStorage.removeItem('cooldownSecondsLeft');
      }
    }, 1000);
  }

  function startOTPTimer() {
    let secondsLeft = localStorage.getItem('otpExpirationTime') || otpExpirationTime;
    if (countdownInterval) clearInterval(countdownInterval);
    countdownInterval = setInterval(() => {
      secondsLeft--;
      let minutes = Math.floor(secondsLeft / 60);
      let seconds = secondsLeft % 60;
      document.getElementById('otpExpirationMessage').innerText = `OTP expires in ${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
      localStorage.setItem('otpExpirationTime', secondsLeft);
      if (secondsLeft <= 0) {
        clearInterval(countdownInterval);
        document.getElementById('otpExpirationMessage').innerText = 'OTP has expired. Please resend.';
        localStorage.removeItem('otpExpirationTime');
        document.getElementById('resendBtn').style.display = 'inline-flex';
      }
    }, 1000);
  }

  function validateOtp() {
    const inputs = document.querySelectorAll('.otp-input');
    let val = '';
    inputs.forEach(i => val += i.value);
    const err = document.getElementById("errmesg-otp");
    if (!/^[\d]{6}$/.test(val)) {
      err.innerText = 'OTP must be a 6-digit number';
      inputs.forEach(i => { i.classList.add('is-invalid'); i.classList.remove('is-valid'); });
      return false;
    }
    err.innerText = '';
    inputs.forEach(i => { i.classList.remove('is-invalid'); i.classList.add('is-valid'); });
    return true;
  }

  function validateForm() {
    if (!validateOtp()) { return false; }
    return true;
  }

  document.addEventListener('DOMContentLoaded', function() {
    startOTPTimer();
    startResendCooldown();
  });
</script>

<%- include('../layout/footer') %>
