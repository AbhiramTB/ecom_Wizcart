<%- include('../layout/header') %>

<style>
  .wz-wishlist-card {
    background: var(--wz-white);
    border-radius: var(--wz-radius-lg);
    box-shadow: var(--wz-shadow-md);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .wz-wishlist-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--wz-shadow-xl);
  }
  .wz-wishlist-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }
  .wz-wishlist-card .card-body {
    padding: var(--wz-space-4);
  }
  .wz-wishlist-card .card-title {
    font-size: var(--wz-fs-base);
    font-weight: var(--wz-fw-semibold);
    margin-bottom: var(--wz-space-2);
    color: var(--wz-dark);
  }
  .wz-wishlist-card .card-text {
    font-size: var(--wz-fs-lg);
    font-weight: var(--wz-fw-bold);
    color: var(--wz-accent);
  }
</style>

<div id="page">
  <%- include('../layout/navbar') %>

  <div class="wz-section">
    <div class="wz-container">
      <h2 style="font-size: var(--wz-fs-2xl); font-weight: var(--wz-fw-bold); margin-bottom: var(--wz-space-6);">My Wishlist</h2>

      <% if (typeof wishlistItems === 'undefined' || wishlistItems.length == 0) { %>
        <div class="wz-empty-state">
          <div class="wz-empty-icon">💝</div>
          <h3>Your wishlist is empty</h3>
          <p>Add some of your favorite products to your wishlist and get notified when they go on sale.</p>
          <a href="/shopmore" class="wz-btn wz-btn-primary wz-btn-lg" style="margin-top: var(--wz-space-4);">
            <i class="fas fa-plus" style="margin-right: 6px;"></i> Browse Products
          </a>
        </div>
      <% } else { %>
        <div class="row">
          <% wishlistItems.reverse().forEach(function(product) { %>
            <div class="col-md-4 col-sm-6 mb-4">
              <div class="wz-wishlist-card">
                <img src="<%= product.images[0] %>" alt="<%= product.name %>">
                <div class="card-body">
                  <h5 class="card-title"><%= product.name %></h5>
                  <p class="card-text">₹<%= product.price %></p>
                  <div style="display: flex; gap: var(--wz-space-2); margin-top: var(--wz-space-3);">
                    <input type="hidden" class="wishlist-product-id" value="<%= product.productId %>">
                    <input type="hidden" class="wishlist-price" value="<%= product.price %>">
                    <input type="number" hidden class="wishlist-quantity" value="1" min="1" max="<%= product.in_stock %>">
                    <button class="wz-btn wz-btn-outline wz-btn-sm" style="flex: 1;" onclick="removeFromWishlist('<%= product.productId %>')">
                      <i class="fas fa-times" style="margin-right: 4px;"></i> Remove
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('../layout/siteFooter') %>
</div>

<%- include('../layout/toast') %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function removeFromWishlist(productId) {
    Swal.fire({
      title: "Are you sure?",
      text: "Remove this product from wishlist!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Yes, delete it!"
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(`/wishlist/remove/${productId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            Swal.fire({ title: "Deleted!", text: "Your item has been removed from the wishlist.", icon: "success" })
            .then(() => { location.reload(); });
          } else {
            Swal.fire({ title: "Error!", text: "Failed to remove item from wishlist.", icon: "error" });
          }
        })
        .catch(error => {
          console.error('Error:', error);
          Swal.fire({ title: "Error!", text: "An error occurred while removing the item.", icon: "error" });
        });
      }
    });
  }
</script>

<%- include('../layout/footer') %>