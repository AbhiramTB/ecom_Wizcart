<%- include('../layout/header') %>

<div id="page">
  <div class="colorlib-product">
    <div class="container">
      <div class="row row-pb-lg">
        <div class="col-sm-10 offset-md-1">
          <div class="process-wrap">
            <div class="process text-center active">
              <p><span>01</span></p>
              <h3>Shopping Cart</h3>
            </div>
            <div class="process text-center active">
              <p><span>02</span></p>
              <h3>Checkout</h3>
            </div>
            <div class="process text-center active">
              <p><span>03</span></p>
              <h3>Order Complete</h3>
            </div>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-sm-10 offset-sm-1 text-center">
          <div style="padding: var(--wz-space-12) 0;">
            <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--wz-success); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--wz-space-6);">
              <i class="fas fa-check" style="font-size: 2rem; color: white;"></i>
            </div>
            <h2 class="mb-4">Thank you! Your order is complete</h2>
            <p style="color: var(--wz-text-muted); margin-bottom: var(--wz-space-8);">We've received your order and will begin processing it soon.</p>
            <a href="/" class="wz-btn wz-btn-primary wz-btn-lg" style="margin-right: var(--wz-space-3);">Home</a>
            <a href="/getOrderHistory" class="wz-btn wz-btn-dark wz-btn-lg"><i class="fas fa-truck" style="margin-right: 6px;"></i> Track Order</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../layout/siteFooter') %>
</div>

<%- include('../layout/footer') %>
