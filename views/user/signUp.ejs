<%- include('../layout/header') %>

<style>
  .wz-auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--wz-primary) 0%, var(--wz-primary-light) 50%, var(--wz-secondary) 100%);
    padding: var(--wz-space-4);
  }
  .wz-auth-card {
    background: var(--wz-white);
    border-radius: var(--wz-radius-xl);
    box-shadow: var(--wz-shadow-2xl);
    overflow: hidden;
    max-width: 860px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
  }
  .wz-auth-brand {
    background: var(--wz-primary);
    color: var(--wz-white);
    padding: var(--wz-space-10);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .wz-auth-brand i { font-size: 3rem; color: var(--wz-accent); margin-bottom: var(--wz-space-4); }
  .wz-auth-brand h2 { font-size: var(--wz-fs-2xl); margin-bottom: var(--wz-space-3); color: var(--wz-white); }
  .wz-auth-brand p { color: var(--wz-gray-400); font-size: var(--wz-fs-sm); margin-bottom: var(--wz-space-6); }
  .wz-google-btn {
    display: flex; align-items: center; gap: var(--wz-space-3);
    background: rgba(255,255,255,0.08); color: var(--wz-white);
    padding: var(--wz-space-3) var(--wz-space-6); border-radius: var(--wz-radius-md);
    font-size: var(--wz-fs-sm); font-weight: var(--wz-fw-medium);
    transition: all var(--wz-transition-fast); text-decoration: none;
    border: 1px solid rgba(255,255,255,0.12);
  }
  .wz-google-btn:hover { background: rgba(255,255,255,0.14); color: var(--wz-white); }
  .wz-auth-form { padding: var(--wz-space-8); }
  .wz-auth-form h2 { font-size: var(--wz-fs-xl); margin-bottom: var(--wz-space-6); }
  .wz-form-group { margin-bottom: var(--wz-space-5); position: relative; }
  .wz-form-control { padding: var(--wz-space-3) var(--wz-space-4); width: 100%; border: 1.5px solid var(--wz-gray-300); border-radius: var(--wz-radius-md); font-size: var(--wz-fs-sm); transition: all 0.2s; }
  .wz-form-control:focus { outline: none; border-color: var(--wz-accent); box-shadow: 0 0 0 3px rgba(233,69,96,0.1); }
  .wz-form-control.is-invalid { border-color: var(--wz-danger); }
  .wz-form-control.is-valid { border-color: var(--wz-success); }
  .wz-form-error { color: var(--wz-danger); font-size: var(--wz-fs-xs); margin-top: 4px; position: absolute; top: 100%; left: 0; }
  .wz-pw-toggle { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; color: var(--wz-gray-500); }
  .server-error { background: var(--wz-danger-bg); border: 1px solid #f5c6cb; color: #721c24; padding: var(--wz-space-3); border-radius: var(--wz-radius-md); margin-bottom: var(--wz-space-4); text-align: center; font-size: var(--wz-fs-sm); }
  @media (max-width: 767px) {
    .wz-auth-card { grid-template-columns: 1fr; }
    .wz-auth-brand { padding: var(--wz-space-6); }
    .wz-auth-form { padding: var(--wz-space-6); }
  }
</style>

<div class="wz-auth-page">
  <div class="wz-auth-card">
    <div class="wz-auth-brand">
      <img src="../images/logo.png" alt="Logo" style="width: 180px; height: 60px; object-fit: contain; margin-bottom: var(--wz-space-4);">
      <p>Sign up using social media to get quick access</p>
      <a href="/signup/google" class="wz-google-btn">
        <i class="fab fa-google"></i> Sign up with Google
      </a>
    </div>
    <div class="wz-auth-form">
      <h2>Create Your Account</h2>
      <% if (typeof(message) !== 'undefined') { %>
        <div class="server-error"><%= message %></div>
      <% } %>
      <form id="SignUPForm" action="/signupData" method="post" onsubmit="return validateForm()">
        <div class="wz-form-group">
          <input type="text" name="name" class="wz-form-control" id="name" placeholder="Full Name" required onkeyup="vname()">
          <div id="errmesg-name" class="wz-form-error"></div>
        </div>
        <div class="wz-form-group">
          <input type="email" name="email" class="wz-form-control" id="email" placeholder="Email Address" required onkeyup="vemail()">
          <div id="errmesg-email" class="wz-form-error"></div>
        </div>
        <div class="wz-form-group">
          <input type="password" name="password" class="wz-form-control" id="password" placeholder="Password" required onkeyup="vpassword()">
          <i class="far fa-eye wz-pw-toggle" onclick="togglePassword('password')"></i>
          <div id="errmesg-password" class="wz-form-error"></div>
        </div>
        <div class="wz-form-group">
          <input type="password" name="confirm_password" class="wz-form-control" id="confirm_password" placeholder="Confirm Password" required onkeyup="vpassword()">
          <i class="far fa-eye wz-pw-toggle" onclick="togglePassword('confirm_password')"></i>
          <div id="errmesg-confirm-password" class="wz-form-error"></div>
        </div>
        <button type="submit" class="wz-btn wz-btn-primary wz-btn-block wz-btn-lg" style="margin-top: var(--wz-space-4);">Sign Up</button>
      </form>
      <div style="text-align: center; margin-top: var(--wz-space-5);">
        <p style="font-size: var(--wz-fs-sm); color: var(--wz-text-secondary);">Already have an account? <a href="/login" style="color: var(--wz-accent); font-weight: var(--wz-fw-semibold);">Log in</a></p>
      </div>
    </div>
  </div>
</div>

<script>
  function vemail() {
    const el = document.getElementById("email");
    const err = document.getElementById("errmesg-email");
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value)) {
      err.innerText = 'Invalid email format';
      el.classList.add('is-invalid'); el.classList.remove('is-valid');
    } else {
      err.innerText = '';
      el.classList.remove('is-invalid'); el.classList.add('is-valid');
    }
  }

  function vpassword() {
    const pw = document.getElementById("password");
    const cpw = document.getElementById("confirm_password");
    const err = document.getElementById("errmesg-password");
    const cerr = document.getElementById("errmesg-confirm-password");
    if (!/^(?=.*[!@#$%&*])[a-zA-Z0-9!@#$%&*]{6,}$/.test(pw.value)) {
      err.innerText = 'Min 6 chars, at least 1 special character (!@#$%&*)';
      pw.classList.add('is-invalid'); pw.classList.remove('is-valid');
    } else {
      err.innerText = '';
      pw.classList.remove('is-invalid'); pw.classList.add('is-valid');
    }
    if (cpw.value !== pw.value) {
      cerr.innerText = 'Passwords do not match';
      cpw.classList.add('is-invalid'); cpw.classList.remove('is-valid');
    } else {
      cerr.innerText = '';
      cpw.classList.remove('is-invalid'); cpw.classList.add('is-valid');
    }
  }

  function vname() {
    const el = document.getElementById("name");
    const err = document.getElementById("errmesg-name");
    if (!/^[a-zA-Z ]{2,30}$/.test(el.value)) {
      err.innerText = 'Name must be 2–30 characters';
      el.classList.add('is-invalid'); el.classList.remove('is-valid');
    } else {
      err.innerText = '';
      el.classList.remove('is-invalid'); el.classList.add('is-valid');
    }
  }

  function validateForm() {
    vemail(); vpassword(); vname();
    return !document.querySelectorAll('.is-invalid').length;
  }

  function togglePassword(id) {
    const input = document.getElementById(id);
    const icon = input.nextElementSibling;
    if (input.type === "password") {
      input.type = "text";
      icon.classList.replace("fa-eye", "fa-eye-slash");
    } else {
      input.type = "password";
      icon.classList.replace("fa-eye-slash", "fa-eye");
    }
  }
</script>

<%- include('../layout/footer') %>
