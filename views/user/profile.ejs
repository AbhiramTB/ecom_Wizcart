<%- include('../layout/header') %>
<link rel="stylesheet" href="/css/profileStyle.css">
<link rel="stylesheet" href="/css/mystyle.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div id="page">
  <%- include('../layout/navbar') %>

  <div class="container light-style flex-grow-1 container-p-y my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="font-weight-bold text-dark mb-0">
        Account Settings
      </h3>
    </div>

    <div class="card shadow-sm border-0 rounded-lg overflow-hidden">
      <div class="row no-gutters row-bordered row-border-light">
        <!-- Sidebar Navigation -->
        <div class="col-md-3 bg-light border-right">
          <div class="list-group list-group-flush account-settings-links py-3">
            <a class="list-group-item list-group-item-action active font-weight-bold py-3" data-toggle="list" href="#account-general">
              <i class="fas fa-user-cog mr-2"></i> General Profile
            </a>
            <a class="list-group-item list-group-item-action font-weight-bold py-3" data-toggle="list" href="#account-change-password">
              <i class="fas fa-key mr-2"></i> Change Password
            </a>
            <a class="list-group-item list-group-item-action font-weight-bold py-3" href="/manageaddress">
              <i class="fas fa-map-marker-alt mr-2"></i> Manage Addresses
            </a>
          </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-md-9 bg-white">
          <div class="tab-content p-4">

            <!-- General Profile Tab -->
            <div class="tab-pane fade active show" id="account-general">
              <!-- User Profile Header -->
              <div class="d-flex align-items-center mb-4 p-3 bg-light rounded border">
                <div class="avatar-circle bg-primary text-white d-flex align-items-center justify-content-center font-weight-bold rounded-circle mr-3" style="width: 64px; height: 64px; font-size: 24px;">
                  <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div>
                  <h5 class="mb-1 font-weight-bold text-dark" id="displayUserName"><%= user.name %></h5>
                  <p class="text-muted mb-0 small"><i class="fas fa-envelope mr-1"></i> <%= user.email %></p>
                </div>
              </div>

              <hr class="my-4 border-light">

              <!-- Profile Edit Form -->
              <form id="profileNameForm" onsubmit="event.preventDefault(); updateNameSubmit();">
                <div class="form-group mb-4 col-md-8 px-0">
                  <label for="NewName" class="form-label font-weight-bold">Full Name</label>
                  <input id="NewName" type="text" class="form-control form-control-lg" value="<%= user.name %>" placeholder="Enter your full name" onkeyup="vname()">
                  <div id="errmesg-name" class="text-danger small mt-1"></div>
                  <small class="form-text text-muted">Name must be 2–30 characters long and contain only letters and spaces.</small>
                </div>

                <div class="form-group mb-4 col-md-8 px-0">
                  <button id="NameSumbit" type="submit" class="btn btn-primary px-4 py-2 font-weight-bold">
                    <i class="fas fa-save mr-1"></i> Save Name Changes
                  </button>
                </div>
              </form>

              <hr class="my-4 border-light">

              <!-- Email Field (Read Only) -->
              <div class="form-group col-md-8 px-0">
                <label for="displayEmail" class="form-label font-weight-bold">Email Address</label>
                <div class="input-group">
                  <input id="displayEmail" type="email" class="form-control form-control-lg bg-light" value="<%= user.email %>" readonly>
                  <div class="input-group-append">
                    <span class="input-group-text bg-success text-white font-weight-bold px-3">
                      <i class="fas fa-check-circle mr-1"></i> Verified
                    </span>
                  </div>
                </div>
                <small class="form-text text-muted mt-1"><i class="fas fa-lock mr-1"></i> Email address</small>
              </div>

            </div>

            <!-- Change Password Tab -->
            <div class="tab-pane fade" id="account-change-password">
              <h5 class="font-weight-bold mb-4">Security & Password</h5>
              
              <!-- Current Password -->
              <div class="form-group col-md-8 px-0 mb-3 style-pw-container" style="position: relative;">
                <label for="current-password" class="form-label font-weight-bold">Current Password</label>
                <input id="current-password" type="password" class="form-control form-control-lg pr-5" placeholder="Enter current password" onkeyup="vpassword()">
                <i class="fas fa-eye text-muted pw-toggle-btn" style="position: absolute; right: 15px; top: 44px; cursor: pointer; z-index: 10;" onclick="togglePasswordVisibility('current-password', this)"></i>
                <div id="errmesg-password1" class="text-danger small mt-1"></div>
                <div class="mt-1 text-right">
                  <a href="/forgetPassword" class="small text-primary font-weight-bold">Forgot Password?</a>
                </div>
              </div>

              <!-- New Password -->
              <div class="form-group col-md-8 px-0 mb-3 style-pw-container" style="position: relative;">
                <label for="new-password" class="form-label font-weight-bold">New Password</label>
                <input id="new-password" type="password" class="form-control form-control-lg pr-5" placeholder="Enter new password" onkeyup="vpassword()">
                <i class="fas fa-eye text-muted pw-toggle-btn" style="position: absolute; right: 15px; top: 44px; cursor: pointer; z-index: 10;" onclick="togglePasswordVisibility('new-password', this)"></i>
                <div id="errmesg-password2" class="text-danger small mt-1"></div>
              </div>

              <!-- Confirm New Password -->
              <div class="form-group col-md-8 px-0 mb-4 style-pw-container" style="position: relative;">
                <label for="conform-new-password" class="form-label font-weight-bold">Confirm New Password</label>
                <input id="conform-new-password" type="password" class="form-control form-control-lg pr-5" placeholder="Re-enter new password" onkeyup="vpassword()">
                <i class="fas fa-eye text-muted pw-toggle-btn" style="position: absolute; right: 15px; top: 44px; cursor: pointer; z-index: 10;" onclick="togglePasswordVisibility('conform-new-password', this)"></i>
                <div id="errmesg-password3" class="text-danger small mt-1"></div>
              </div>

              <button class="btn btn-primary px-4 py-2 font-weight-bold" id="passSumbit" onclick="newPasswordSumbit()">
                <i class="fas fa-key mr-1"></i> Update Password
              </button>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../layout/footer') %>
</div>

<div class="gototop js-top">
  <a href="#" class="js-gotop"><i class="ion-ios-arrow-up"></i></a>
</div>

<% if (typeof toast !== 'undefined' && toast && toast.length > 0) { %>
  <div id="toast" class="toast-black toast show">
    <%= toast[0] %>
  </div>
<% } %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var toast = document.getElementById('toast');
    if (toast) {
      toast.classList.add('show');
      setTimeout(function() {
        toast.classList.remove('show');
      }, 3000);
    }
  });

  // Toggle Password Visibility
  function togglePasswordVisibility(inputId, iconEl) {
    const input = document.getElementById(inputId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      iconEl.classList.remove('fa-eye');
      iconEl.classList.add('fa-eye-slash');
    } else {
      input.type = 'password';
      iconEl.classList.remove('fa-eye-slash');
      iconEl.classList.add('fa-eye');
    }
  }

  // Name Validation matching signup logic (2-30 chars, letters/spaces only)
  function vname() {
    const el = document.getElementById("NewName");
    const err = document.getElementById("errmesg-name");
    const submitBtn = document.getElementById('NameSumbit');
    const val = (el.value || "").trim();

    if (!/^[a-zA-Z ]{2,30}$/.test(val)) {
      err.innerText = 'Name must be 2–30 characters long and contain only letters and spaces';
      el.classList.add('is-invalid');
      el.classList.remove('is-valid');
      submitBtn.disabled = true;
      return false;
    } else {
      err.innerText = '';
      el.classList.remove('is-invalid');
      el.classList.add('is-valid');
      submitBtn.disabled = false;
      return true;
    }
  }

  function updateNameSubmit() {
    if (!vname()) {
      Swal.fire({
        icon: 'error',
        title: 'Invalid Name',
        text: 'Please enter a valid name (2–30 characters, letters only).'
      });
      return;
    }

    const newName = document.getElementById('NewName').value.trim();
    const data = { updateName: newName };

    fetch('/updatename', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(data),
    })
    .then(response => response.json())
    .then(data => {
      if (data.success || data.message) {
        Swal.fire({
          position: "center",
          icon: "success",
          title: "Name Updated",
          text: `Your profile name has been updated to "${newName}"`,
          showConfirmButton: false,
          timer: 1800
        });

        document.getElementById('displayUserName').innerText = newName;
        const circle = document.querySelector('.avatar-circle');
        if (circle) circle.innerText = newName.charAt(0).toUpperCase();
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Update Failed',
          text: data.message || 'Failed to update name.'
        });
      }
    })
    .catch(error => {
      console.error('Error:', error);
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'An error occurred while updating your name.'
      });
    });
  }

  function newPasswordSumbit() {
    const currentPass = document.getElementById('current-password').value;
    const newPass = document.getElementById('new-password').value;
    const conformPass = document.getElementById('conform-new-password').value;

    if (newPass !== conformPass) {
      Swal.fire({
        icon: 'error',
        title: 'Mismatch',
        text: 'New password and confirm password do not match.'
      });
      return;
    }

    const data = {
      currentPass: currentPass,
      newPass: newPass
    };

    fetch('/ProfilUpdatePass', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(data => {
      if (data.message && !data.error) {
        Swal.fire({
          position: "center",
          icon: "success",
          title: "Password Updated",
          text: data.message,
          showConfirmButton: false,
          timer: 1800
        });
        document.getElementById('current-password').value = '';
        document.getElementById('new-password').value = '';
        document.getElementById('conform-new-password').value = '';
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Update Failed',
          text: data.message || 'Current password is incorrect. Please try again.'
        });
      }
    })
    .catch(err => {
      console.error('Error:', err);
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Failed to update password.'
      });
    });
  }

  // Password Validation matching exact Login password rules
  function vpassword() {
    const currentPass = document.getElementById('current-password');
    const newPassEl = document.getElementById('new-password');
    const confirmPassEl = document.getElementById('conform-new-password');
    
    const newPass = newPassEl.value;
    const confirmPass = confirmPassEl.value;
    
    const err1 = document.getElementById("errmesg-password1");
    const err2 = document.getElementById("errmesg-password2");
    const err3 = document.getElementById("errmesg-password3");

    // Exact Login Password Regex: Min 6 characters, at least 1 special char from !@#$%&*
    const LOGIN_PASSWORD_REGEX = /^(?=.*[!@#$%&*])[a-zA-Z0-9!@#$%&*]{6,}$/;

    // Current Password check
    if (!LOGIN_PASSWORD_REGEX.test(currentPass.value)) {
      err1.innerText = 'Min 6 chars, at least 1 special character (!@#$%&*)';
      currentPass.classList.add('is-invalid');
      currentPass.classList.remove('is-valid');
    } else {
      err1.innerText = '';
      currentPass.classList.remove('is-invalid');
      currentPass.classList.add('is-valid');
    }

    // New Password check
    if (!LOGIN_PASSWORD_REGEX.test(newPass)) {
      err2.innerText = 'Min 6 chars, at least 1 special character (!@#$%&*)';
      newPassEl.classList.add('is-invalid');
      newPassEl.classList.remove('is-valid');
    } else {
      err2.innerText = '';
      newPassEl.classList.remove('is-invalid');
      newPassEl.classList.add('is-valid');
    }

    // Confirm Password check
    if (newPass !== confirmPass || !LOGIN_PASSWORD_REGEX.test(confirmPass)) {
      err3.innerText = 'Passwords do not match or do not meet requirements';
      confirmPassEl.classList.add('is-invalid');
      confirmPassEl.classList.remove('is-valid');
    } else {
      err3.innerText = '';
      confirmPassEl.classList.remove('is-invalid');
      confirmPassEl.classList.add('is-valid');
    }

    const hasErrors = err1.innerText !== '' || err2.innerText !== '' || err3.innerText !== '';
    document.getElementById('passSumbit').disabled = hasErrors;
  }
</script>