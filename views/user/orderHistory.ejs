<%- include('../layout/header') %>

<div id="page">
  <%- include('../layout/navbar') %>

  <div class="wz-section">
    <div class="wz-container">
      <div class="wz-section-title">
        <h2>Order History</h2>
      </div>

      <% if (orders.length === 0) { %>
        <div class="wz-empty-state">
          <div class="wz-empty-icon">📦</div>
          <h3>No orders found</h3>
          <p>Start shopping to see your order history here.</p>
          <a href="/shopmore" class="wz-btn wz-btn-primary mt-4">Shop Now</a>
        </div>
      <% } else { %>
        <% orders.forEach(order => { %>
          <div class="wz-card mb-4">
            <div class="wz-card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
              <span style="font-size: var(--wz-fs-sm);">Order Number: <strong><%= order.orderNumber || 'N/A' %></strong> (ID: <%= order._id %>)</span>
              <span class="wz-badge wz-badge-accent"><%= order.status %></span>
            </div>
            <div class="wz-card-body">
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--wz-space-4); margin-bottom: var(--wz-space-4);">
                <div>
                  <p style="font-size: var(--wz-fs-xs); color: var(--wz-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Name</p>
                  <p style="font-weight: var(--wz-fw-semibold); margin-bottom: 0;"><%= order.name %></p>
                </div>
                <div>
                  <p style="font-size: var(--wz-fs-xs); color: var(--wz-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Payment</p>
                  <p style="font-weight: var(--wz-fw-semibold); margin-bottom: 0;"><%= order.paymentMethod %></p>
                </div>
                <div>
                  <p style="font-size: var(--wz-fs-xs); color: var(--wz-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Date</p>
                  <p style="font-weight: var(--wz-fw-semibold); margin-bottom: 0;"><%= new Date(order.orderDate).toLocaleDateString() %></p>
                </div>
              </div>

              <h6 style="margin-top: var(--wz-space-4); margin-bottom: var(--wz-space-3);">Shipping Address</h6>
              <p style="font-size: var(--wz-fs-sm); color: var(--wz-text-secondary);">
                <%= order.shipment_address.name %>, <%= order.shipment_address.address %>, <%= order.shipment_address.locality %>, <%= order.shipment_address.city %>, <%= order.shipment_address.state %> - <%= order.shipment_address.pincode %>
              </p>

              <h6 style="margin-top: var(--wz-space-4); margin-bottom: var(--wz-space-3);">Products</h6>
              <% order.product.forEach((prod, index) => { %>
                <div style="display: flex; gap: var(--wz-space-4); padding: var(--wz-space-3) 0; border-bottom: 1px solid var(--wz-gray-100);">
                  <img src="<%= order.newone[index].product_img[0] %>" alt="<%= order.newone[index].product_name %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: var(--wz-radius-md);">
                  <div>
                    <p style="font-weight: var(--wz-fw-semibold); margin-bottom: 4px;"><%= order.newone[index].product_name %></p>
                    <p style="font-size: var(--wz-fs-sm); color: var(--wz-text-muted); margin-bottom: 0;">Qty: <%= prod.quantity %> × ₹<%= order.newone[index].price %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

</div>

<%- include('../layout/footer') %>
