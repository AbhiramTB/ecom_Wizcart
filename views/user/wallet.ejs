<%- include('../layout/header') %>

<style>
  .wallet-container {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--wz-space-6);
  }
  .wallet-header {
    background: linear-gradient(135deg, var(--wz-primary), var(--wz-secondary));
    border-radius: var(--wz-radius-xl);
    padding: var(--wz-space-8);
    color: var(--wz-white);
    margin-bottom: var(--wz-space-8);
    box-shadow: var(--wz-shadow-xl);
  }
  .wallet-header h1 { color: var(--wz-white); font-size: var(--wz-fs-2xl); margin-bottom: var(--wz-space-2); }
  .wallet-balance { font-size: 2.5rem; font-weight: var(--wz-fw-bold); color: var(--wz-success); }
  .transaction-item {
    padding: var(--wz-space-4);
    margin-bottom: var(--wz-space-3);
    background: var(--wz-white);
    border-radius: var(--wz-radius-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-left: 4px solid var(--wz-success);
    transition: transform var(--wz-transition-fast);
    box-shadow: var(--wz-shadow-sm);
  }
  .transaction-item:hover { transform: translateY(-2px); box-shadow: var(--wz-shadow-md); }
  .transaction-item.debit { border-left-color: var(--wz-danger); }
  .transaction-description { font-size: var(--wz-fs-sm); font-weight: var(--wz-fw-semibold); color: var(--wz-text-primary); margin-bottom: 4px; }
  .transaction-date { font-size: var(--wz-fs-xs); color: var(--wz-text-muted); }
  .transaction-amount { font-size: var(--wz-fs-lg); font-weight: var(--wz-fw-bold); }
  .transaction-amount.credit { color: var(--wz-success); }
  .transaction-amount.debit { color: var(--wz-danger); }
</style>

<div id="page">
  <%- include('../layout/navbar') %>

  <div class="wz-section">
    <div class="wallet-container">
      <div class="wallet-header">
        <h1><i class="fas fa-wallet" style="margin-right: 8px;"></i> My Wallet</h1>
        <p class="wallet-balance">₹<%= balance.toFixed(2) %></p>
      </div>

      <h5 style="margin-bottom: var(--wz-space-4); font-weight: var(--wz-fw-semibold);">Transaction History</h5>

      <% if (transactions.length === 0) { %>
        <div class="wz-empty-state">
          <div class="wz-empty-icon">💳</div>
          <h3>No transactions yet</h3>
          <p>Your transaction history will appear here.</p>
        </div>
      <% } else { %>
        <% transactions.reverse().forEach(function(transaction) { %>
          <div class="transaction-item <%= transaction.type === 'debited' ? 'debit' : '' %>">
            <div>
              <p class="transaction-description"><%= transaction.description %></p>
              <p class="transaction-date"><%= new Date(transaction.date).toLocaleDateString() %></p>
            </div>
            <p class="transaction-amount <%= transaction.type === 'debited' ? 'debit' : 'credit' %>">
              <%= transaction.type === 'debited' ? '-' : '+' %>₹<%= Math.abs(transaction.amount).toFixed(2) %>
            </p>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <%- include('../layout/site-footer') %>
</div>

<%- include('../layout/footer') %>
