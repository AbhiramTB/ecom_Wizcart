<%- include('../layout/header') %>

<div id="page">
  <div class="colorlib-product">
    <div class="container">
      <div class="row row-pb-lg">
        <div class="col-sm-10 offset-md-1">
          <div class="process-wrap">
            <div class="process text-center active">
              <p><span>01</span></p>
              <h3>Shopping Cart</h3>
            </div>
            <div class="process text-center active">
              <p><span>02</span></p>
              <h3>Checkout</h3>
            </div>
            <div class="process text-center" style="border-color: var(--wz-danger);">
              <p><span style="background: var(--wz-danger);">03</span></p>
              <h3 style="color: var(--wz-danger);">Payment Failed</h3>
            </div>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-sm-10 offset-sm-1 text-center">
          <div style="padding: var(--wz-space-12) 0;">
            <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--wz-danger); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--wz-space-6);">
              <i class="fas fa-exclamation" style="font-size: 2rem; color: white;"></i>
            </div>
            <h2 class="mb-4" style="color: var(--wz-danger);">Payment Failed</h2>
            <p style="color: var(--wz-text-muted); margin-bottom: var(--wz-space-2);">Your order is on hold due to a payment issue.</p>
            <p style="color: var(--wz-text-muted); margin-bottom: var(--wz-space-8);">Please try again or choose a different payment method.</p>
            <a href="/getOrderHistory" class="wz-btn wz-btn-primary wz-btn-lg" style="margin-right: var(--wz-space-3);"><i class="far fa-credit-card" style="margin-right: 6px;"></i> Retry Payment</a>
            <a href="/" class="wz-btn wz-btn-outline wz-btn-lg">Return to Home</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../layout/siteFooter') %>
</div>

<%- include('../layout/footer') %>
