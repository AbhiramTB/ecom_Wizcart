<%- include('../layout/header') %>

<style>
  .wz-ban-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
    padding: var(--wz-space-4);
  }
  .wz-ban-card {
    background: var(--wz-white);
    border-radius: var(--wz-radius-xl);
    padding: var(--wz-space-12);
    text-align: center;
    box-shadow: var(--wz-shadow-xl);
    max-width: 480px;
    width: 100%;
  }
  .wz-ban-card .wz-ban-icon {
    font-size: 5rem;
    color: var(--wz-danger);
    margin-bottom: var(--wz-space-6);
  }
  .wz-ban-card h1 {
    color: var(--wz-danger);
    font-size: var(--wz-fs-2xl);
    margin-bottom: var(--wz-space-3);
  }
  .wz-ban-card p {
    color: var(--wz-text-secondary);
    font-size: var(--wz-fs-sm);
    margin-bottom: var(--wz-space-2);
  }
</style>

<div class="wz-ban-page">
  <div class="wz-ban-card">
    <i class="fa-solid fa-ban wz-ban-icon"></i>
    <h1>Account Blocked</h1>
    <p>Your account has been blocked by the administrator.</p>
    <p>If you believe this is a mistake, please contact the Wizcart support team.</p>
    <a href="/" class="wz-btn wz-btn-danger wz-btn-lg" style="margin-top: var(--wz-space-6);">Return to Home</a>
  </div>
</div>

<%- include('../layout/footer') %>
