<%- include('../layout/header') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
  .wz-auth-page {
    min-height: 100vh; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--wz-primary) 0%, var(--wz-primary-light) 50%, var(--wz-secondary) 100%);
    padding: var(--wz-space-4);
  }
  .wz-reset-card {
    background: var(--wz-white); border-radius: var(--wz-radius-xl); box-shadow: var(--wz-shadow-2xl);
    max-width: 480px; width: 100%; padding: var(--wz-space-10);
  }
  .wz-reset-card h2 { font-size: var(--wz-fs-xl); margin-bottom: var(--wz-space-6); text-align: center; }
  .wz-reset-card .wz-form-group { margin-bottom: var(--wz-space-5); }
  .wz-reset-card .wz-form-control { padding: var(--wz-space-3) var(--wz-space-4); width: 100%; border: 1.5px solid var(--wz-gray-300); border-radius: var(--wz-radius-md); font-size: var(--wz-fs-sm); transition: all 0.2s; }
  .wz-reset-card .wz-form-control:focus { outline: none; border-color: var(--wz-accent); box-shadow: 0 0 0 3px rgba(233,69,96,0.1); }
  .strength-meter { height: 4px; border-radius: 2px; overflow: hidden; background: var(--wz-gray-200); margin-top: 8px; }
  .strength-meter div { height: 100%; transition: width 0.3s, background 0.3s; }
  .strength-weak { width: 25%; background: var(--wz-danger); }
  .strength-medium { width: 50%; background: var(--wz-warning); }
  .strength-strong { width: 75%; background: orange; }
  .strength-very-strong { width: 100%; background: var(--wz-success); }
  .hidden { display: none; }
  .brand-icon { text-align: center; margin-bottom: var(--wz-space-6); }
  .brand-icon i { font-size: 2.5rem; color: var(--wz-accent); }
</style>

<div class="wz-auth-page">
  <div class="wz-reset-card">
    <div class="brand-icon">
      <img src="../images/logo.png" alt="Logo" style="width: 180px; height: 60px; object-fit: contain; margin-bottom: var(--wz-space-4);">
    </div>
    <h2>Reset Password</h2>

    <form id="emailForm">
      <div class="wz-form-group">
        <label class="wz-form-label" for="email-input">Email Address</label>
        <input type="email" class="wz-form-control" id="email-input" placeholder="Enter your email" required>
      </div>
      <button type="button" class="wz-btn wz-btn-primary wz-btn-block wz-btn-lg" onclick="sendEmail()">Get OTP</button>
    </form>

    <form id="otpPasswordForm" action="/loadforgetpass" method="post" class="hidden" onsubmit="return vpassword()">
      <div class="wz-form-group">
        <label class="wz-form-label" for="otp-input">OTP</label>
        <input type="text" class="wz-form-control" name="ForgotOtp" id="otp-input" placeholder="Enter the OTP" required>
        <div style="display: flex; justify-content: space-between; margin-top: 8px;">
          <span style="font-size: var(--wz-fs-xs); color: var(--wz-danger);">OTP expires in 2 minutes</span>
          <a href="/forgetpassword" style="font-size: var(--wz-fs-xs);">Resend OTP?</a>
        </div>
      </div>
      <div class="wz-form-group">
        <label class="wz-form-label" for="newPassword">New Password</label>
        <input type="password" class="wz-form-control" name="newPassword" id="newPassword" placeholder="Enter new password" oninput="checkPasswordStrength()" required>
        <div class="strength-meter"><div id="strength-bar"></div></div>
        <div id="errmesg-password" style="color: var(--wz-danger); font-size: var(--wz-fs-xs); margin-top: 4px;"></div>
      </div>
      <div class="wz-form-group">
        <label class="wz-form-label" for="confirmPassword">Confirm Password</label>
        <input type="password" class="wz-form-control" id="confirmPassword" placeholder="Confirm new password" required>
      </div>
      <div style="margin-bottom: var(--wz-space-4);">
        <label style="font-size: var(--wz-fs-sm); cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <input type="checkbox" id="showPassword"> Show Password
        </label>
      </div>
      <input type="text" value="" name="emailUp" hidden>
      <button type="submit" class="wz-btn wz-btn-primary wz-btn-block wz-btn-lg">Update Password</button>
    </form>

    <div style="text-align: center; margin-top: var(--wz-space-5);">
      <a href="/login" style="font-size: var(--wz-fs-sm); color: var(--wz-accent);">Back to Login</a>
    </div>
  </div>
</div>

<script>
  document.getElementById('showPassword').addEventListener('change', function() {
    const np = document.getElementById('newPassword');
    const cp = document.getElementById('confirmPassword');
    np.type = this.checked ? 'text' : 'password';
    cp.type = this.checked ? 'text' : 'password';
  });

  let otpValid = false;

  function vpassword() {
    const pw = document.getElementById('newPassword');
    const cpw = document.getElementById('confirmPassword');
    const err = document.getElementById('errmesg-password');
    let valid = true;
    if (!/^(?=.*[!@#$%&*])[a-zA-Z0-9!@#$%&*]{6,}$/.test(pw.value)) {
      err.innerText = 'Min 6 chars, at least 1 special character (!@#$%&*)';
      pw.classList.add('is-invalid'); valid = false;
    } else { pw.classList.remove('is-invalid'); pw.classList.add('is-valid'); }
    if (pw.value !== cpw.value) {
      err.innerText = 'Passwords do not match';
      cpw.classList.add('is-invalid'); valid = false;
    } else { cpw.classList.remove('is-invalid'); cpw.classList.add('is-valid'); }
    return valid;
  }

  function checkPasswordStrength() {
    const pw = document.getElementById('newPassword').value;
    const bar = document.getElementById('strength-bar');
    bar.className = '';
    if (pw.length >= 10 && /\d/.test(pw) && /[^\w\d]/.test(pw)) bar.classList.add('strength-very-strong');
    else if (pw.length >= 8 && /\d/.test(pw)) bar.classList.add('strength-strong');
    else if (pw.length >= 6) bar.classList.add('strength-medium');
    else bar.classList.add('strength-weak');
  }

  function sendEmail() {
    const email = document.getElementById('email-input').value;
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { Swal.fire('Error', 'Please enter a valid email.', 'error'); return; }
    Swal.fire({ title: "Please wait", html: "Sending OTP...", timer: 3000, timerProgressBar: true, didOpen: () => Swal.showLoading() });
    fetch('/forgotEmail', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) })
    .then(r => { if (!r.ok) throw new Error('Network error'); return r.json(); })
    .then(data => {
      if (data.success) {
        document.getElementById('emailForm').classList.add('hidden');
        document.getElementById('otpPasswordForm').classList.remove('hidden');
        Swal.fire({ icon: 'success', title: 'OTP Sent!', html: `OTP sent to <strong>${email}</strong>`, timer: 2500, showConfirmButton: false });
      } else {
        Swal.fire({ icon: 'error', title: 'Oops...', text: 'Email not registered. Please sign up.' });
      }
    })
    .catch(() => { Swal.fire({ icon: 'error', title: 'Error', text: 'Email not registered.', footer: '<a href="/signup">Sign up here?</a>' }); });
  }
</script>

<%- include('../layout/footer') %>
