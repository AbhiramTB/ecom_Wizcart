<%- include('../layout/header') %>

<div id="page">
  <%- include('../layout/navbar') %>

  <div class="wz-section py-5">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Order Details</h2>
        <a href="/getOrderHistory" class="btn btn-outline-secondary">
          <i class="fas fa-arrow-left"></i> Back to Orders
        </a>
      </div>

      <div class="row g-4">
        <!-- Address Card -->
        <div class="col-lg-6 mb-4">
          <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
              <h5 class="mb-0 text-white"><i class="fas fa-map-marker-alt"></i> Shipping Address</h5>
            </div>
            <div class="card-body bg-light text-dark p-4">
              <h5 class="card-title font-weight-bold text-gray-800"><%= order.name %></h5>
              <hr>
              <p class="mb-2"><strong>Mobile:</strong> <%= order.shipment_address.mobile %></p>
              <% if (order.shipment_address.altmobile) { %>
                <p class="mb-2"><strong>Alt Mobile:</strong> <%= order.shipment_address.altmobile %></p>
              <% } %>
              <p class="mb-2"><strong>Locality:</strong> <%= order.shipment_address.locality %></p>
              <p class="mb-2"><strong>Address:</strong> <%= order.shipment_address.address %></p>
              <p class="mb-2"><strong>City:</strong> <%= order.shipment_address.city %></p>
              <p class="mb-2"><strong>State:</strong> <%= order.shipment_address.state %> - <%= order.shipment_address.pincode %></p>
              <% if (order.shipment_address.landmark) { %>
                <p class="mb-2"><strong>Landmark:</strong> <%= order.shipment_address.landmark %></p>
              <% } %>
              <p class="mb-0 mt-3">
                <span class="badge badge-secondary p-2 text-uppercase"><%= order.shipment_address.addresstype || 'Home' %></span>
              </p>
            </div>
          </div>
        </div>

        <!-- Summary & Actions Card -->
        <div class="col-lg-6 mb-4">
          <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
              <h5 class="mb-0 text-white"><i class="fas fa-file-invoice"></i> Order Summary</h5>
            </div>
            <div class="card-body p-4">
              <!-- Order Header details -->
              <div class="mb-3 d-flex justify-content-between align-items-center">
                <span class="text-muted">Order Number:</span>
                <strong><%= order.orderNumber || 'N/A' %></strong>
              </div>
              <div class="mb-3 d-flex justify-content-between align-items-center">
                <span class="text-muted">Order Date:</span>
                <strong><%= new Date(order.orderDate).toLocaleDateString() %></strong>
              </div>
              <div class="mb-4 d-flex justify-content-between align-items-center">
                <span class="text-muted">Payment Method:</span>
                <span class="badge badge-dark p-2 text-uppercase"><%= order.paymentMethod %></span>
              </div>
              <hr>

              <!-- Product Info -->
              <div class="d-flex align-items-center gap-3 mb-4">
                <img
                  src="<%= productInfo.product_img && productInfo.product_img[0] ? productInfo.product_img[0] : '/images/placeholder.png' %>"
                  alt="<%= productInfo.product_name %>"
                  class="img-thumbnail mr-3"
                  style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;"
                >
                <div>
                  <h5 class="font-weight-bold mb-1"><%= productInfo.product_name %></h5>
                  <p class="text-primary mb-1 font-weight-bold">₹<%= productInfo.price %></p>
                  <p class="text-muted mb-0">Quantity: <%= productItem.quantity %></p>
                </div>
              </div>

              <!-- Price breakdown -->
              <table class="table table-borderless bg-light rounded p-3 mb-4">
                <tbody>
                  <tr>
                    <td class="text-muted">Subtotal</td>
                    <td class="text-end text-dark font-weight-bold">
                      <%= productItem.quantity %> × ₹<%= productInfo.price %> = ₹<%= productInfo.price * productItem.quantity %>
                    </td>
                  </tr>
                  <tr class="border-top table-success">
                    <td><strong>Total Price</strong></td>
                    <td class="text-end text-success font-weight-bold h5">
                      ₹<%= productInfo.price * productItem.quantity %>
                    </td>
                  </tr>
                </tbody>
              </table>

              <!-- Status Alert Blocks -->
              <% if (productItem.status === 'pending') { %>
                <div class="alert alert-warning p-3">
                  <i class="far fa-clock"></i> <strong>Pending:</strong> Product delivery is in progress.
                </div>
              <% } else if (productItem.status === 'shipped') { %>
                <div class="alert alert-info p-3">
                  <i class="fas fa-truck"></i> <strong>Shipped:</strong> Product has been shipped.
                </div>
              <% } else if (productItem.status === 'delivered') { %>
                <div class="alert alert-success p-3">
                  <i class="fas fa-check-circle"></i> <strong>Delivered:</strong> Product delivered successfully.
                </div>
              <% } else if (productItem.status === 'cancelled' || productItem.status === 'canceled') { %>
                <div class="alert alert-danger p-3">
                  <i class="fas fa-ban"></i> <strong>Cancelled:</strong> Order cancelled. Refund credited to wallet (if not Cash on Delivery).
                </div>
              <% } else if (productItem.status === 'Returned') { %>
                <div class="alert alert-success p-3">
                  <i class="fas fa-undo"></i> <strong>Returned:</strong> Product returned successfully. Refund credited.
                </div>
              <% } else if (productItem.status === 'return pending') { %>
                <div class="alert alert-warning p-3">
                  <i class="fas fa-hourglass-half"></i> <strong>Return Pending:</strong> Return request pending.
                </div>
              <% } else if (productItem.status === 'return rejected') { %>
                <div class="alert alert-danger p-3">
                  <i class="fas fa-times-circle"></i> <strong>Return Rejected:</strong> Return request rejected.
                </div>
              <% } %>

              <!-- Action buttons -->
              <div class="d-flex gap-2 justify-content-end mt-4">
                <% if (productItem.status === 'pending') { %>
                  <button type="button" onclick="confirmOrderCancell()" class="btn btn-danger btn-lg px-4">
                    <i class="fas fa-times-circle"></i> Cancel Order
                  </button>
                <% } %>
                <% if (productItem.status === 'delivered') { %>
                  <button type="button" onclick="ConformOderReturn()" class="btn btn-warning btn-lg px-4 mr-2">
                    <i class="fas fa-undo"></i> Return
                  </button>
                  <button type="button" onclick="conformDownload()" class="btn btn-primary btn-lg px-4">
                    <i class="fas fa-file-invoice"></i> Download Invoice
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if (productItem.status === 'delivered' || productItem.status === 'Returned') { %>
        <div class="row mt-4">
          <div class="col-12">
            <div class="card shadow-sm border-0">
              <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 text-white"><i class="fas fa-star"></i> Product Review</h5>
              </div>
              <div class="card-body p-4 bg-light text-dark">
                <% if (typeof existingReview !== 'undefined' && existingReview) { %>
                  <div class="p-3 bg-white border rounded">
                    <h6 class="font-weight-bold text-primary mb-2">Your Submitted Review</h6>
                    <p class="mb-1"><%= existingReview.userReview %></p>
                    <small class="text-muted"><%= new Date(existingReview.createdAt).toLocaleDateString() %></small>
                  </div>
                <% } else { %>
                  <form action="/submitReview" method="post">
                    <input type="hidden" name="productId" value="<%= productInfo._id %>">
                    <input type="hidden" name="orderId" value="<%= order.orderNumber %>">
                    <div class="mb-3">
                      <label for="userReview" class="form-label font-weight-bold">How was your experience with this product?</label>
                      <textarea class="form-control" id="userReview" name="userReview" rows="4" required placeholder="Write your review here..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Submit Review</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('../layout/footer') %>
</div>

<!-- Forms for user actions -->
<form id="cancelForm" action="/ordercancellation" method="post" style="display: none;">
  <input type="hidden" name="object_id" value="<%= order.orderNumber %>">
  <input type="hidden" name="product_id" value="<%= productItem._id %>">
  <input type="hidden" name="product_name" value="<%= productInfo.product_name %>">
</form>

<form id="returnForm" action="/orderreturn" method="post" style="display: none;">
  <input type="hidden" name="object_id" value="<%= order.orderNumber %>">
  <input type="hidden" name="product_id" value="<%= productItem._id %>">
  <input type="hidden" name="product_price" value="<%= productInfo.price %>">
  <input type="hidden" name="product_name" value="<%= productInfo.product_name %>">
</form>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function confirmOrderCancell() {
    Swal.fire({
      title: 'Are you sure?',
      text: "Confirm your cancellation request!",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Cancel Order',
      cancelButtonText: 'No, keep it',
      reverseButtons: true
    }).then((result) => {
      if (result.isConfirmed) {
        document.getElementById('cancelForm').submit();
      }
    });
  }

  function ConformOderReturn() {
    Swal.fire({
      title: 'Are you sure?',
      text: "Confirm your return request!",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Confirm Return',
      cancelButtonText: 'No, keep it',
      reverseButtons: true
    }).then((result) => {
      if (result.isConfirmed) {
        document.getElementById('returnForm').submit();
      }
    });
  }

  function conformDownload() {
    Swal.fire({
      title: 'Confirm Download',
      text: 'Are you sure you want to download the product invoice?',
      icon: 'question',
      showCancelButton: true,
      confirmButtonText: 'Yes, download it!',
      cancelButtonText: 'No, cancel'
    }).then((result) => {
      if (result.isConfirmed) {
        Swal.fire({
          title: 'Downloading...',
          text: 'Your invoice will be downloaded shortly.',
          timer: 2000,
          didOpen: () => {
            Swal.showLoading();
          }
        }).then(() => {
          window.location.href = '/invoiceDownload/<%= order.orderNumber %>/<%= productItem._id %>';
        });
      }
    });
  }
</script>
