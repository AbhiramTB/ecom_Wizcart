<%- include('./adminLayout/header') %>
<link rel="stylesheet" href="css/mystyle.css">
<body id="page-top">

    
    <div id="wrapper">

        
    <%- include('./adminLayout/sidebar') %>


        

        
        <div id="content-wrapper" class="d-flex flex-column">

            
            <div id="content">

                
            
                

                <div class="container">
                 
                
                    
                    <div class="card mt-3">
                      <div class="card-header ">
                        <h3>Categories</h3>
                      </div>
                      <div class="card-body">
                        <ul class="list-group">
                            <% categories.forEach((e, index) => { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center" <% if (e.Hide_category == 1) { %> style="background-color:bg-light;" <% } %>>
                                  <h3 class="text-start font-monospace text-dark"><%= e.category_name %></h3>
                                  <div class="d-flex">
                                    <% if (e.Hide_category == 1) { %>
                                      <form action="/catShow" method="post" onsubmit="return confirmUnhide(event,this)" class="me-2 ml-3 mr-3">
                                        <input type="hidden" name="id" value="<%= e._id %>">
                                        <button type="submit" class="btn btn-secondary btn-m" title="Show"><i class="fas fa-eye"></i></button>
                                      </form>
                                    <% } else { %>
                                      <form action="/catHide" method="post" onsubmit="return confirmhide(event,this)" class="me-2 ml-3 mr-3">
                                        <input type="hidden" name="id" value="<%= e._id %>">
                                        <button type="submit" class="btn btn-secondary btn-m" title="Hide"><i class="fas fa-eye-slash"></i></button>
                                      </form>
                                    <% } %>
                                    
                                    <input type="hidden" name="id" id="editCatId<%= index %>" value="<%= e._id %>">
                                    <input type="text" class="editCategoryName" id="editCatName<%= index %>" hidden value="<%= e.category_name %>">
                                    <button type="button" data-bs-toggle="modal" data-bs-target="#exampleModal" hidden id="editModal<%= index %>"></button>
                                    <button type="button" class="btn btn-primary btn-m me-3 ms-3" onclick="confirmedit(<%=index%>)" title="Edit"><i class="fas fa-edit"></i></button>
                                    
                                    <form action="/catDelete" method="post" onsubmit="return confirmDelete(event,this)" id="deleteForm-<%= e._id %>" class="ml-3">
                                      <input type="hidden" name="id" value="<%= e._id %>">
                                      <button type="submit" class="btn btn-danger btn-m" title="Delete"><i class="fas fa-trash"></i></button>
                                    </form>
                                  </div>
                                </li>
                              <% }) %>
                              
                          
                        </ul>
                      </div>
                    </div>
                
                    
                    <div class="card mt-3">
                      <div class="card-header">
                        <h3>Add New Category</h3>
                      </div>
                      <div class="card-body">
                        <form action="/addCategory" method="post">
                          <div class="mb-3">
                            <label for="categoryName" class="form-label">Category Name</label>
                            <input type="text" class="form-control" name="newCategory" id="categoryName" onkeyup="validateCategoryInput()" required placeholder="Enter category name">
                          </div>
                          <button type="submit"  class="btn btn-primary">Add Category</button>
                        </form>
                      </div>
                    </div>
                  </div>
                
                  
                  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                  
                  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js"></script>
    
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="login.html">Logout</a>
                </div>
            </div>
        </div>
    </div>
    <% if (toast.length > 0) { %>
        <div id="toast" class="toast-black  toast show"><%= toast[0] %></div>
    <% } %>





    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

function validateCategoryInput() {
      const categoryInput = document.getElementById('categoryName');
      const submitButton = document.querySelector('button[type="submit"]');
      const trimmedValue = categoryInput.value.trim();

      if (trimmedValue === ' ' || categoryInput.value.startsWith(' ')) {
        categoryInput.setCustomValidity('Category name cannot be empty or start with a whitespace.');
        submitButton.disabled = true;
      } else {
        categoryInput.setCustomValidity('');
        submitButton.disabled = false;
      }
    }


    function confirmDelete(event, form) {
    event.preventDefault(); // Prevent the default form submission

    Swal.fire({
  
    html: '<span style="color: #000000;"> Are you sure you want to delete this Categorie?</span>',
    showCancelButton: true,
    background: '#ffffff', // Set the background to white
    confirmButtonColor: "#3085d6",
    cancelButtonColor: "#d33",
    confirmButtonText: "delete",
    imageUrl: 'https://assets-v2.lottiefiles.com/a/e09820ea-116b-11ee-8e93-4f2a1602d144/HdbA8EJlUN.gif', // Add your image path here
    imageWidth: 300, // Optional: adjust the width of the image
    imageHeight: 150, // Optional: adjust the height of the image
    imageAlt: 'Custom image', // Optional: add an alt text for the image
})

.then((result) => {
        if (result.isConfirmed) {
            Swal.fire({
                title: "Deleted!",
                text: "Your file has been deleted.",
                icon: "success"
            }).then(() => {
                form.submit(); 
            });
        }
    });
    return false; 
}


function confirmedit(index) {
    Swal.fire({
        title: 'Are you sure?',
        text: "Do you want to edit this category?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, edit it!'
    }).then((result) => {
        if (result.isConfirmed) {
            // Trigger the hidden button to show the modal
            document.getElementById('editModal' + index).click();

            // Set the modal input values
            document.getElementById('modalEditCatName').value = document.getElementById('editCatName' + index).value;
            document.getElementById('catEditId').value = document.getElementById('editCatId' + index).value;
        }
    });
}


function confirmUnhide(event,form) {
   
    Swal.fire({
        title:'<span style="color: #00000;">  Are you sure you want to show this category?"</span>',
        text: "unHide",
        icon: "warning",
        showCancelButton: true,
        background:'#fffff',
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        cancelButtonText: "keep IT hide",
        confirmButtonText: "Yes, Show"
    }).then((result) => {
        if (result.isConfirmed) {
            Swal.fire({
                title: "show",
                text: "category has been unhide.",
                icon: "success"
            }).then(() => {
                form.submit(); 
            });
        }
    });
    return false; 
}


function confirmhide(event,form) {
    
    Swal.fire({
        title:'<span style="color: #00000;">  Are you sure you want to hide this category?"</span>',
        text: " HIDE",
        icon: "warning",
        showCancelButton: true,
        background:'#fffff',
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        cancelButtonText: "keep IT unhide",
        confirmButtonText: "Yes, hide"
    }).then((result) => {
        if (result.isConfirmed) {
            Swal.fire({
                title: "HIDE",
                text: "category has been HIDE.",
                icon: "success"
            }).then(() => {
                form.submit(); 
            });
        }
    });
    return false
}

document.addEventListener('DOMContentLoaded', function() {
        var toast = document.getElementById('toast');
        if (toast) {
            toast.classList.add('show');
            // Hide the toast message after 3 seconds (3000 milliseconds)
            setTimeout(function() {
                toast.classList.remove('show');
            }, 7000);
        }
    }); 


        (function () {
          'use strict';
    
          // Fetch all the forms we want to apply custom Bootstrap validation styles to
          var forms = document.querySelectorAll('.needs-validation');
    
          // Loop over them and prevent submission
          Array.prototype.slice.call(forms)
            .forEach(function (form) {
              form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                  event.preventDefault();
                  event.stopPropagation();
                }
    
                form.classList.add('was-validated');
              }, false);
            });
        })();
    
   
      </script>

    <%- include('./adminLayout/footer') %>