
<%- include('./adminLayout/header') %>
<link rel="stylesheet" href="css/mystyle.css">
<body class="bg-light">
  <div class="admin-layout">
    <%- include('./partials/topbar') %>
    <main class="admin-main-content">
      <div class="container-fluid">
               
<div class="container-fluid">
    <h2 class="mb-4">Product Orders</h2>
    <input type="text" id="searchInput" class="form-control mb-3" placeholder="Search...">

    <% if (orders.length === 0) { %>
        <div class="alert alert-info">
            <div class="card">
                <div class="card-body">
                    No orders found.
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="table-responsive text-dark">
            <table class="table table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ORDER&nbspNO</th>
                        <th>PRODUCT</th>
                        <th>quantity</th>
                        <th>USERNAME</th>
                        <th>STATUS</th>
                        <th>ORDER&nbspDATE</th>
                        <th>CUSTOMERS&nbspDETAILS</th>
                        <th>EDIT STATUS</th>
                        <th>DETAILS</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach((order, index) => { %>
                        <% order.product.forEach((product, index) => { %>
                            <% if (order.newone[index]) { %>
                                <tr class="<%= product.status.toLowerCase() === 'cancelled' ? 'table-danger' : product.status.toLowerCase() === 'pending' ? 'table-warning' : product.status.toLowerCase() === 'shipped' ? 'table-info' : product.status.toLowerCase() === 'delivered' ? 'table-success' : '' %> align-middle">
                                    <td><%= order.orderNumber || 'N/A' %></td>
                                    <td><%= order.newone[index].product_name || 'Product Name Not Available' %></td>
                                    <td><%= product.quantity %></td>
                                     
                                    <td><%= order.name %></td>
                                    <td><%= product.status %></td>
                                    <td><%= new Date(order.orderDate).toLocaleDateString() %></td>
                                    <td>
                                        <div class="address p-3 border rounded text-dark">
                                            <p>
                                                <strong>Name:</strong> <%= order.shipment_address.name %>, 
                                                <strong>Mobile:</strong> <%= order.shipment_address.mobile %>, 
                                                <strong>Pincode:</strong> <%= order.shipment_address.pincode %>, 
                                                <strong>Locality:</strong> <%= order.shipment_address.locality %>, 
                                                <strong>Address:</strong> <%= order.shipment_address.address %>, 
                                                <strong>City:</strong> <%= order.shipment_address.city %>, 
                                                <strong>State:</strong> <%= order.shipment_address.pincode %>, 
                                                <strong>Landmark:</strong> <%= order.shipment_address.landmark %>,                                             
                                                <strong>Address Type:</strong> <%= order.shipment_address.addresstype %>
                                            </p>
                                        </div>
                                    </td>
                                   <% if(product.status=='return rejected'){%>
                                    <td>
                                      
                                          <div class="alert alert-danger" role="alert">
                                            return rejected      
                                            <a href="/returnOrders">manage return</a>                              
                                              </div>
                                    </td>
                                     <% } else if (product.status=='Returned') { %>
                                        <td>
                                            <div class="alert alert-success" role="alert">
                                                Returned
                                                <a href="/returnOrders">manage return</a>
                                              </div>
                                        </td>
                                      <% } else if (product.status=='return pending') { %>
                                        <td>
                                            <div class="alert alert-warning" role="alert">
                                                return pending
                                                <a href="/returnOrders">manage return</a>
                                              </div>
                                        </td>
                                       <% } else { %>
                                            <td>
                                        <form id="statusUpdate-<%= product._id %>">
                                            <input type="hidden" name="product_id" value="<%= product._id %>">
                                            <input type="hidden" name="object_id" value="<%= order.orderNumber %>">

                                            <%
                                              const currentStatus = product.status.toLowerCase();
                                              const nextOptions = {
                                                pending:   [{ value: 'shipped',   label: 'Shipped' },   { value: 'cancelled', label: 'Cancelled' }],
                                                shipped:   [{ value: 'delivered', label: 'Delivered' }, { value: 'cancelled', label: 'Cancelled' }],
                                                delivered: [],
                                                cancelled: [],
                                                canceled:  [],
                                              };
                                              const options = nextOptions[currentStatus] || [];
                                            %>

                                            <% if (options.length === 0) { %>
                                              <span class="badge display-block
                                                <%= currentStatus === 'delivered' ? 'badge-success' : 'badge-danger' %>
                                                p-2">
                                                <%= currentStatus === 'delivered' ? 'Delivered ' : 'Cancelled ' %>
                                                <br>
                                              order Completed
                                             </span>
                                            <% } else { %>
                                              <select name="status" class="form-select mb-2">
                                                <option value="" disabled selected>change-status</option>
                                                <% options.forEach(opt => { %>
                                                  <option value="<%= opt.value %>"><%= opt.label %></option>
                                                <% }); %>
                                              </select>
                                              <button
                                                type="button"
                                                onclick="editStatus('<%= product._id %>', '<%= product.status.toLowerCase() %>', '<%= order.paymentMethod %>', '<%= order.payment || order.Payment || '' %>', '<%= order.finalPrice %>')"
                                                class="btn btn-dark btn-sm">
                                                Update Status
                                              </button>
                                            <% } %>
                                        </form>
                                    </td>
                                    <% } %>
                                    <td>
                                        <a href="/orderDetails?id=<%= order.orderNumber %>" class="btn btn-info btn-sm">View Details</a>
                                    </td>
                                </tr>
                            <% } %>
                        <% }) %>
                    <% }) %>
                </tbody>
            </table>
        </div>

        
        <nav>
            <ul class="pagination">
                <% if (currentPage > 1) { %>
                    <li class="page-item">
                        <a class="page-link" href="/orderMangement?page=<%= currentPage - 1 %>&limit=<%= limit %>">Previous</a>
                    </li>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link" href="/orderMangement?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                    </li>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                        <a class="page-link" href="/orderMangement?page=<%= currentPage + 1 %>&limit=<%= limit %>">Next</a>
                    </li>
                <% } %>
            </ul>
        </nav>
    <% } %>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
    .card-body {
        background: #f9f9f9;
    }
    .address {
        background: #f8f9fa;
    }
</style>

                
               
                
             
                


            

            
          
            

        </div>
        


    

    
  

    
    

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

   <script>
  function editStatus(productId, currentStatus, paymentMethod, paymentStatus, finalPrice) {
    const form = document.getElementById(`statusUpdate-${productId}`);
    const selectEl = form.querySelector('select[name="status"]');
    if (!selectEl) return;
    const selectedStatus = selectEl.value;

    if (!selectedStatus) {
      Swal.fire({ icon: 'warning', title: 'No status selected', text: 'Please pick a status from the dropdown.' });
      return;
    }

    // ── Payment guard: Pending → Shipped for non-COD ──
    const isCOD = paymentMethod.toLowerCase() === 'cod';
    const isPaid = paymentStatus.toLowerCase() === 'success';
    if (currentStatus === 'pending' && selectedStatus === 'shipped' && !isCOD && !isPaid) {
      Swal.fire({
        icon: 'error',
        title: 'Payment Not Completed',
        html: `This order was placed via ${paymentMethod} but payment not received .<br><br>You can change the status until the payment is confirmed.`,
        confirmButtonColor: '#d33',
        confirmButtonText: 'OK'
      });
      return;
    }

    const isIrreversible = selectedStatus === 'delivered' || selectedStatus === 'cancelled';
    const statusLabels = { shipped: 'Shipped', delivered: 'Delivered', cancelled: 'Cancelled' };
    const label = statusLabels[selectedStatus] || selectedStatus;

    const confirmConfig = {
      shipped: {
        icon: 'question',
        title: 'Mark as Shipped?',
        text: 'The order will be marked as shipped. You can still cancel or deliver it afterwards.',
        confirmText: 'Yes, Ship it!',
        confirmColor: '#3085d6'
      },
      delivered: {
        icon: 'warning',
        title: 'Mark as Delivered?',
        html: '<strong>This action is final and cannot be undone.</strong><br>Once delivered, the order status cannot be changed.',
        confirmText: 'Yes, Mark Delivered',
        confirmColor: '#28a745'
      },
      cancelled: {
        icon: 'warning',
        title: 'Cancel this order?',
        html: '<strong>This action is final and cannot be undone.</strong><br>Stock will be restored automatically.',
        confirmText: 'Yes, Cancel Order',
        confirmColor: '#d33'
      }
    }[selectedStatus];

    Swal.fire({
      icon: confirmConfig.icon,
      title: confirmConfig.title,
      html: confirmConfig.html,
      text: confirmConfig.text,
      showCancelButton: true,
      confirmButtonColor: confirmConfig.confirmColor,
      cancelButtonColor: '#6c757d',
      confirmButtonText: confirmConfig.confirmText,
      cancelButtonText: 'Go Back'
    }).then((result) => {
      if (!result.isConfirmed) return;

      // ── Submit via fetch so we can catch backend errors ──
      const formData = new FormData(form);
      fetch('/update-status', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-requested-with': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          product_id: formData.get('product_id'),
          object_id:  formData.get('object_id'),
          status:     selectedStatus
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Updated!',
            text: `Order status changed to ${label}.`,
            timer: 1800,
            showConfirmButton: false
          }).then(() => window.location.reload());
        } else {
          Swal.fire({ icon: 'error', title: 'Update Failed', text: data.message || 'Something went wrong.' });
        }
      })
      .catch(() => {
        Swal.fire({ icon: 'error', title: 'Network Error', text: 'Could not reach the server. Please try again.' });
      });
    });
  }


document.getElementById("searchInput").addEventListener('keyup', function() {
            var filter = this.value.toLowerCase();
            var rows = document.querySelectorAll('table tbody tr');

            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });


    </script>
      </div> 
    </main>
  </div>
<%- include('./adminLayout/footer') %>

