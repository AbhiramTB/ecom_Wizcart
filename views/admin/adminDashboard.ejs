<%- include('./adminLayout/header') %>
  <link rel="stylesheet" href="css/mystyle.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>

  <body class="bg-light">
    <div class="admin-layout">
      <%- include('./partials/sidebar') %>
      <main class="admin-main-content">
        <div class="container-fluid">

            <div class="container py-5">
              <h1 class="text-center mb-5">Sales Dashboard</h1>
              <hr>
              <label for="" class="text-dark">custom date:</label>
              <div class="row mb-5">
                <div class="col-12">
                  <form action="/dashboard" method="GET" class="input-group">
                    <input type="date" name="startDate" class="form-control" placeholder="Start Date">
                    <input type="date" name="endDate" class="form-control" placeholder="End Date">
                    <button class="btn btn-primary" type="submit">Filter</button>
                  </form>

                  <hr>

                  <div class="btn-group d-flex justify-content-center" role="group">
                    <a href="/dashboard?filter=today"
                      class="btn  btn-outline-primary <%= filterOption === 'today' ? 'active' : '' %>">
                      <i class="fas fa-calendar-day"></i> Today
                    </a>
                    <a href="/dashboard?filter=week"
                      class="btn btn-outline-primary <%= filterOption === 'week' ? 'active' : '' %>">
                      <i class="fas fa-calendar-week"></i> This Week
                    </a>
                    <a href="/dashboard?filter=month"
                      class="btn btn-outline-primary <%= filterOption === 'month' ? 'active' : '' %>">
                      <i class="fas fa-calendar-alt"></i> This Month
                    </a>
                    <a href="/dashboard?filter=year"
                      class="btn btn-outline-primary <%= filterOption === 'year' ? 'active' : '' %>">
                      <i class="fas fa-calendar"></i> This Year
                    </a>
                  </div>
                </div>
              </div>

              <div class="row mb-5">
                <div class="col-md-3 mb-4">
                  <div class="card bg-accent text-white h-100">
                    <div class="card-body">
                      <h5 class="card-title"><i class="fas fa-box me-2"></i>Ordered Products</h5>
                      <p class="card-text text-white display-4">
                        <%=totalOrderedProductCount %>
                      </p>
                      <h6 class="card-subtitle">for week</h6>
                    </div>
                  </div>
                </div>
                <div class="col-md-3 mb-4">
                  <div class="card admin-metric-card bg-accent  text-black  text-white h-100">
                    <div class="card-body">
                      <h5 class="card-title"><i class="fas fa-chart-line me-2"></i>Total Sales</h5>
                      <p class="card-text display-4 text-white">
                        <%=totalSales %>
                      </p>
                      <h6 class="card-subtitle">for week</h6>
                    </div>
                  </div>
                </div>
                <div class="col-md-3 mb-4">
                  <div class="card admin-metric-card bg-accent  text-black text-white h-100">
                    <div class="card-body">
                      <h5 class="card-title"><i class="fas fa-percent me-2"></i>Total Discounts</h5>
                      <p class="card-text text-white  display-4">
                        <%=totalDiscount %>
                      </p>
                      <h6 class="card-subtitle">for week</h6>
                    </div>
                  </div>
                </div>
                <div class="col-md-3 mb-4">
                  <div class="card admin-metric-card bg-accent  text-black text-white h-100">
                    <div class="card-body">
                      <h5 class="card-title"><i class="fas fa-coins me-2"></i>Final Revenue</h5>
                      <p class="card-text text-white display-4">₹<%=totalProfit %>
                      </p>
                      <h6 class="card-subtitle">for week</h6>
                    </div>
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-8 mb-4">
                  <div class="card">
                    <div class="card-body">
                      <h5 class="card-title mb-4">Sales Over Time</h5>
                      <div class="chart-container">
                        <canvas id="salesChart"></canvas>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-md-4 mb-4">
                  <div class="card">
                    <div class="card-body">
                      <h5 class="card-title mb-4">Payment Methods</h5>
                      <div class="chart-container">
                        <canvas id="paymentMethodsChart"></canvas>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <hr>
              <hr>
              <hr>
              <style>
           

                @keyframes fadeInUp {
                  from {
                    opacity: 0;
                    transform: translate3d(0, 40px, 0);
                  }

                  to {
                    opacity: 1;
                    transform: translate3d(0, 0, 0);
                  }
                }

                .animated {
                  animation-duration: 1s;
                  animation-fill-mode: both;
                }

                .fadeInUp {
                  animation-name: fadeInUp;
                }
              </style>


              <div class="container mt-5">
                <h1 class="text-center mb-5 animated fadeInUp">Top Sellers Dashboard</h1>

                <div class="row">
                  
                  <div class="col-md-4 mb-4 animated fadeInUp" style="animation-delay: 0.2s;">
                    <div class="card">
                      <div class="card-body">
                        <h5 class="card-title text-center">
                          <i class="fas fa-box product-icon"></i>Top 10 Best Selling Products
                        </h5>
                        <ol class="list-group list-group-numbered">
                          <% topProducts.forEach(product=> { %>
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                              <div class="ms-2 me-auto">
                                <div class="fw-bold">
                                  <%= product.productDetails.product_name %>
                                </div>
                                <small class="text-muted">
                                  Category: <%= product.productDetails.category_name %>
                                    <br>
                                    Current Price:₹<%= product.productDetails.price %>
                                </small>
                              </div>
                              <span class="badge">
                                <%= product.count %> sold
                              </span>
                            </li>
                            <% }) %>
                        </ol>
                      </div>
                    </div>
                  </div>

                  
                  <div class="col-md-4 mb-4 animated fadeInUp" style="animation-delay: 0.4s;">
                    <div class="card">
                      <div class="card-body">
                        <h5 class="card-title text-center">
                          <i class="fas fa-tags category-icon"></i>Top 10 Best Selling Categories
                        </h5>
                        <ol class="list-group list-group-numbered">
                          <% topCategories.forEach(category=> { %>
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                              <div class="ms-2 me-auto">
                                <div class="fw-bold">
                                  <%= category._id %>
                                </div>
                              </div>
                              <span class="badge">
                                <%= category.count %> items sold
                              </span>
                            </li>
                            <% }) %>
                        </ol>
                      </div>
                    </div>
                  </div>

                  
                  <div class="col-md-4 mb-4 animated fadeInUp" style="animation-delay: 0.6s;">
                    <div class="card">
                      <div class="card-body">
                        <h5 class="card-title text-center">
                          <i class="fas fa-trademark brand-icon"></i>Top 10 Best Selling Brands
                        </h5>
                        <ol class="list-group list-group-numbered">
                          <% topBrands.forEach(brand=> { %>
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                              <div class="ms-2 me-auto">
                                <div class="fw-bold">
                                  <%= brand._id %>
                                </div>
                              </div>
                              <span class="badge">
                                <%= brand.count %> items sold
                              </span>
                            </li>
                            <% }) %>
                        </ol>
                      </div>
                    </div>
                  </div>
                </div>
              </div>


            </div>

            <script>
              document.addEventListener("DOMContentLoaded", function () {
                // Sales Chart
                const salesCtx = document.getElementById('salesChart').getContext('2d');

                const salesData = {
                  labels: <%- JSON.stringify(salesData.labels) %>,
                  datasets: [{
                    label: 'Total Sales',
                    data: <%- JSON.stringify(salesData.sales) %>,
                    backgroundColor: 'rgba(13, 110, 253, 0.7)',
                    borderColor: 'rgba(13, 110, 253, 1)',
                    borderWidth: 2,
                    borderRadius: 8,
                    hoverBackgroundColor: 'rgba(13, 110, 253, 0.9)',
                    hoverBorderColor: 'rgba(13, 110, 253, 1)',
                  }]
                };

                new Chart(salesCtx, {
                  type: 'bar',
                  data: salesData,
                  options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                      legend: { display: false },
                      tooltip: {
                        mode: 'index',
                        intersect: false,
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleColor: '#ffffff',
                        bodyColor: '#ffffff',
                        borderColor: '#ffffff',
                        borderWidth: 1,
                        cornerRadius: 5,
                        displayColors: false,
                        callbacks: {
                          label: function (context) {
                            return `Sales: ₹${context.parsed.y.toLocaleString()}`;
                          }
                        }
                      }
                    },
                    scales: {
                      x: {
                        type: 'category',
                        title: {
                          display: true,
                          text: 'Date',
                          color: '#0d6efd',
                          font: { size: 14, weight: 'bold' }
                        },
                        grid: { display: false },
                        ticks: { color: '#0d6efd' }
                      },
                      y: {
                        title: {
                          display: true,
                          text: '(net revenue)',
                          color: '#0d6efd',
                          font: { size: 14, weight: 'bold' }
                        },
                        grid: { borderDash: [3, 3], color: '#d3d3d3' },
                        ticks: { color: '#0d6efd' }
                      }
                    }
                  }
                });

                // Payment Methods Chart
                const paymentMethodsCtx = document.getElementById('paymentMethodsChart').getContext('2d');

                const paymentMethodsData = {
                  labels: <%- JSON.stringify(paymentMethodsData.labels) %>,
                  datasets: [{
                    label: 'Payment Methods',
                    data: <%- JSON.stringify(paymentMethodsData.values) %>,
                    backgroundColor: [
                      'rgba(255, 99, 132, 0.7)',
                      'rgba(54, 162, 235, 0.7)',
                      'rgba(255, 206, 86, 0.7)',
                      'rgba(75, 192, 192, 0.7)',
                      'rgba(153, 102, 255, 0.7)'
                    ],
                    hoverBackgroundColor: [
                      'rgba(255, 99, 132, 0.9)',
                      'rgba(54, 162, 235, 0.9)',
                      'rgba(255, 206, 86, 0.9)',
                      'rgba(75, 192, 192, 0.9)',
                      'rgba(153, 102, 255, 0.9)'
                    ],
                    borderWidth: 1,
                    borderRadius: 5,
                    hoverOffset: 10
                  }]
                };

                new Chart(paymentMethodsCtx, {
                  type: 'pie',
                  data: paymentMethodsData,
                  options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                      legend: {
                        position: 'bottom',
                        labels: {
                          color: '#0d6efd',
                          font: { size: 14, weight: '500' },
                          padding: 20
                        }
                      },
                      tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleColor: '#ffffff',
                        bodyColor: '#ffffff',
                        borderColor: '#ffffff',
                        borderWidth: 1,
                        cornerRadius: 5,
                        displayColors: false,
                        callbacks: {
                          label: function (context) {
                            return `${context.label}: ₹${context.parsed.toLocaleString()}`;
                          }
                        }
                      }
                    }
                  }
                });
              });
            </script>


        </div>
        

        <% if (toast.length> 0) { %>
          <div id="toast" class="toast-black  toast show">
            <%= toast[0] %>
          </div>
          <% } %>

      </div> <!-- End container-fluid -->
    </main>
  </div>
  <%- include('./adminLayout/footer') %>