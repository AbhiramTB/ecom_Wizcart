<%- include('./adminLayout/header') %>
<link rel="stylesheet" href="css/mystyle.css">

    
    <div id="wrapper">

        
    <%- include('./adminLayout/sidebar') %>

        

        
        <div id="content-wrapper" class="d-flex flex-column">

            
            <div id="content">

                
              

                
                <div class="container-fluid">

                  

                    
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">userMangment</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered" id="usersTable" width="100%" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>userID</th>
                                            <th>status</th>
                                            <th>ban/active</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        
                                    </tfoot>
                                    <tbody>
                                        <% users.forEach(e => { %>
                                            <tr>
                                                <td><%= e.name %></td>
                                                <td><%= e.email %></td>
                                                <td><%= e._id %></td>
                                                <td><%= e.is_ban == 1 ? 'inactive' : 'active' %></td>
                                                <td>
                                                    <% if (e.is_admin == 1) { %>
                                                        <button type="submit" class="btn btn-success" style="width: 150px">ADMIN</button>
                                                    <% } else { %>
                                                        <form action="/blockUser" method="POST">
                                                            <input type="hidden" name="userId" value="<%= e._id %>">
                                                            <input type="hidden" name="newStatus" value="<%= e.is_ban == 1 ? 0 : 1 %>">
                                                            <button type="submit" class="btn btn-primary" style="width: 150px">
                                                                <%= e.is_ban == 1 ? 'UNBLOCK' : 'BLOCK' %>
                                                            </button>
                                                        </form>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                    
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Pagination -->
                    <nav>
                        <ul class="pagination">
                            <% if (currentPage > 1) { %>
                                <li class="page-item">
                                    <a class="page-link" href="/userList?page=<%= currentPage - 1 %>&limit=<%= limit %>">Previous</a>
                                </li>
                            <% } %>
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                    <a class="page-link" href="/userList?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                                </li>
                            <% } %>
                            <% if (currentPage < totalPages) { %>
                                <li class="page-item">
                                    <a class="page-link" href="/userList?page=<%= currentPage + 1 %>&limit=<%= limit %>">Next</a>
                                </li>
                            <% } %>
                        </ul>
                    </nav>

                </div>
                
             
            </div>
        </div>
                  
        
            

         
            

        </div>
        


    

    
   

    
  

    <% if (toast.length > 0) { %>
        <div id="toast" class="toast-black  toast show"><%= toast[0] %></div>
    <% } %>

   <script>

    document.addEventListener('DOMContentLoaded', function() {
        var toast = document.getElementById('toast');
        if (toast) {
            toast.classList.add('show');
            // Hide the toast message after 3 seconds (3000 milliseconds)
            setTimeout(function() {
                toast.classList.remove('show');
            }, 3000);
        }
    });

   </script>
    
    <script src="vendor/jquery/jquery.min.js"></script>
    <script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="js/sb-admin-2.min.js"></script>

    <%- include('./adminLayout/footer') %>

