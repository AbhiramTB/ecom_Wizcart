<%- include('./adminLayout/header') %>
<link rel="stylesheet" href="css/mystyle.css">
<body id="page-top">

    
    <div id="wrapper">

        
    <%- include('./adminLayout/sidebar') %>

        

        
        <div id="content-wrapper" class="d-flex flex-column">

            
            <div id="content">

           
                

                
                <div class="container-fluid">

                    

                    
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">product management</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>product_images</th>
                                            <th>product_name</th>
                                            <th>category_name</th>
                                            <th>brand</th>
                                            <th>price</th>
                                            <th>stock</th>
                                            <th>Edit</th>
                                            <th>Delete</th>
                                            <th>HIDE</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th>product_images</th>
                                            <th>product_name</th>
                                            <th>category_name</th>
                                            <th>brand</th>
                                            <th>price</th>
                                            <th>stock</th>
                                            <th>Edit</th>
                                            <th>Delete</th>
                                            <th>HIDE</th>
                                        </tr>
                                    </tfoot>
                                    <tbody>
                                        <% Product.forEach(e => { %>
                                            
                                            <tr <% if (e.Hide_product == 1) { %> class="text-light" style="background-color: #524d5c" <% } %>>
                                                
                                                <td><img style="width: 100px; margin-left: 5px" src="<%= e.product_img[0]%>"  alt="...">
                                                    <img style="width: 100px; margin-left: 5px" src="<%= e.product_img[1]%>"  alt="...">
                                                    <img style="width: 100px; margin-left: 5px;" src="<%= e.product_img[2]%>"  alt="...">
                                                </td>
                                                <td><%= e.product_name %></td>
                                                <td><%= e.category_name ? e.category_name.category_name : '' %></td>
                                                <td><%= e.brand ? e.brand.brand_name : '—' %></td>
                                                <td><%= e.price %></td>
                                                <td><%= e.in_stock %></td>
                                                <td>
                                                <form action="/editProduct" method="post" onsubmit="return confirmEdit(event)" >
                                                    <input type="text" value="<%=e._id%>" name="id" hidden>
                                                 <button type="submit" class="  btn btn-secondary">-EDIT-</button></td>
                                            </form>
                                            <td> 
                                                
                                                <form id="deleteForm" action="/deleteProduct" method="post" onsubmit="return confirmDelete(event)">
                                                    <input type="text" value="<%= e._id %>" name="_id" hidden>
                                                    <button type="submit" class="btn btn-secondary">DELETE</button>
                                                </form>


                                            </td>
                                                <% if (e.Hide_product===1) { %>       
                                                    <td>
                                                <form action="/UnhideProduct" method="post" id="showForm " onsubmit="return confirmUnhide(event)">
                                                    <input type="hidden" value="<%= e._id %>" name="_id">
                                                    
                                                    
                                                        <button type="submit" class="btn text-danger btn-dark">Show</button> 
                                                    
                                                </form>
                                            </td>
        


                                                <% }else{  %>
                                                    <td> 
                                                <form id="HideForm" action="/HideProduct" method="post" onsubmit="return confirmhide(event)" >
                                                    
                                                    <input type="hidden" value="<%= e._id %>" name="_id">
                                                    
                                                        <button type="submit" class="btn btn-secondary"  >HIDE</button> 
                                                    </td>
                                                </form>
                                                
                                            <% } %>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                    
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
                

            </div>
            

            
           
            

        </div>
        

    </div>
    

    
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="login.html">Logout</a>
                </div>
            </div>
        </div>
    </div>
    <% if (toast.length > 0) { %>
        <div id="toast" class="toast-black  toast show"><%= toast[0] %></div>
    <% } %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

function confirmDelete(event) {
  event.preventDefault(); // Prevent form submission initially

  Swal.fire({
    title: "❌ Are you sure you want to delete this product?",
    text: "You won't be able to revert this!",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#3085d6",
    cancelButtonColor: "#d33",
    confirmButtonText: "Yes, delete it!"
  }).then((result) => {
    if (result.isConfirmed) {
      event.target.submit(); 
    }
  });

  return false; 
}


            

function confirmUnhide(event) {
  event.preventDefault(); 

  Swal.fire({
    title: "Are you sure you want to unhide this product?",
    text: "This action cannot be undone.",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#3085d6",
    cancelButtonColor: "#d33",
    confirmButtonText: "Yes, unhide it!"
  }).then((result) => {
    if (result.isConfirmed) {
      event.target.submit(); 
    }
  });

  return false;
}

function confirmHide(event) {
  event.preventDefault(); // Prevent form submission initially

  Swal.fire({
    title: "Are you sure you want to hide this product?",
    text: "This action cannot be undone.",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#3085d6",
    cancelButtonColor: "#d33",
    confirmButtonText: "Yes, hide it!"
  }).then((result) => {
    if (result.isConfirmed) {
      event.target.submit(); // Submit the form if user confirms
    }
  });

  return false; // Prevent form submission until user confirms
}


function confirmEdit(event) {
  event.preventDefault(); 
  Swal.fire({
    title: "📝 Are you sure you want to edit this product?",
    text: "This action cannot be undone.",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#3085d6",
    cancelButtonColor: "#d33",
    confirmButtonText: "Yes, edit it!"
  }).then((result) => {
    if (result.isConfirmed) {
      event.target.submit(); // Submit the form if user confirms
    }
  });

  return false; // Cancel further form processing until user confirms
}

document.addEventListener('DOMContentLoaded', function() {
        var toast = document.getElementById('toast');
        if (toast) {
            toast.classList.add('show');
            // Hide the toast message after 3 seconds (3000 milliseconds)
            setTimeout(function() {
                toast.classList.remove('show');
            }, 7000);
        }
    });

   
    </script>
    

    
    <script src="vendor/jquery/jquery.min.js"></script>
    <script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    
    <script src="vendor/jquery-easing/jquery.easing.min.js"></script>

    
    <script src="js/sb-admin-2.min.js"></script>

    
    <script src="vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="vendor/datatables/dataTables.bootstrap4.min.js"></script>

    
    <script src="js/demo/datatables-demo.js"></script>

    <%- include('./adminLayout/footer') %>

