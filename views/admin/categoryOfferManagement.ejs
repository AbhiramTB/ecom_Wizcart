<%- include('./adminLayout/header') %>
<link rel="stylesheet" href="css/mystyle.css">
<body class="bg-light">
  <div class="admin-layout">
    <%- include('./partials/topbar') %>
    <main class="admin-main-content">
      <div class="container-fluid">
    <h1 class="mb-4">Category Offer Management</h1>
    <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th scope="col">Category Name</th>
          <th scope="col">Current Offer Discount</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach(category => { %>
        <tr>
          <td><%= category.category_name %></td>
          <td>
            <% if (category.offer && category.offer.discount > 0) { %>
              <span class="badge bg-success">Discount: ₹<%= category.offer.discount.toFixed(2) %></span>
            <% } else { %>
              <span class="badge bg-secondary">No Offer</span>
            <% } %>
          </td>
          <td>
            <div class="d-flex justify-content-start">
              <button class="btn btn-primary btn-sm me-2" data-bs-toggle="modal" data-bs-target="#editOfferModal<%= category._id %>">Edit Offer</button>
          
              <form id="removeOfferForm<%= category._id %>" action="/remove-category-offer" method="post" onsubmit="return confirmRemoveOffer('<%= category._id %>')">
                <input type="hidden" name="category_id" value="<%= category._id %>">
                <button class="btn btn-danger btn-sm" type="submit">Remove Offer</button>
              </form>
            </div>
          </td>
        </tr>

        <div class="modal fade" id="editOfferModal<%= category._id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Edit Offer for <%= category.category_name %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <form action="/new-category-offer" method="POST">
                <div class="modal-body">
                  <div class="mb-3">
                    <label class="form-label">Discount Amount (₹)</label>
                    <input type="number" class="form-control" name="discount" value="<%= category.offer ? category.offer.discount : '' %>" required>
                    <input type="hidden" name="category_id" value="<%= category._id %>">
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                  <button type="submit" class="btn btn-primary">Save Offer</button>
                </div>
              </form>
            </div>
          </div>
        </div>
        <% }); %>
      </tbody>
    </table>
    </div>
  </div>
  </main>
  </div>
<%- include('./adminLayout/footer') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function confirmRemoveOffer(categoryId) {
  event.preventDefault();
  Swal.fire({
    title: 'Are you sure?',
    text: "Do you really want to remove this category offer?",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Yes, remove it!',
    cancelButtonText: 'No, keep it'
  }).then((result) => {
    if (result.isConfirmed) {
      document.getElementById('removeOfferForm' + categoryId).submit();
    }
  });
  return false;
}
</script>
