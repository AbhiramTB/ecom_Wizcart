<%- include('./adminLayout/header') %>
<link rel="stylesheet" href="css/mystyle.css">
<body class="bg-light">
  <div class="admin-layout">
    <%- include('./partials/topbar') %>
    <main class="admin-main-content">
      <div class="container-fluid">
    <h1 class="mb-4">Category Offer Management</h1>
    <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th scope="col">Category Name</th>
          <th scope="col">Current Offer Discount</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach(category => { %>
        <tr>
          <td><%= category.category_name %></td>
          <td>
            <% if (category.offer && category.offer.discount > 0) { %>
              <span class="badge bg-success">Discount: ₹<%= category.offer.discount.toFixed(2) %></span>
            <% } else { %>
              <span class="badge bg-secondary">No Offer</span>
            <% } %>
          </td>
          <td>
            <div class="d-flex justify-content-start">
              <button class="btn btn-primary btn-sm me-2" data-bs-toggle="modal" data-bs-target="#editOfferModal<%= category._id %>">Edit Offer</button>
          
              <form id="removeOfferForm<%= category._id %>" action="/remove-category-offer" method="post" onsubmit="return confirmRemoveOffer(event, '<%= category._id %>')">
                <input type="hidden" name="category_id" value="<%= category._id %>">
                <button class="btn btn-danger btn-sm" type="submit">Remove Offer</button>
              </form>
            </div>
          </td>
        </tr>

        <div class="modal fade" id="editOfferModal<%= category._id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Edit Offer for <%= category.category_name %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <form id="categoryOfferForm<%= category._id %>" action="/new-category-offer" method="POST">
                <div class="modal-body">
                  <div class="mb-3">
                    <label for="categoryDiscount<%= category._id %>" class="form-label">Discount Amount (₹)</label>
                    <input type="number" min="0" step="1" class="form-control" id="categoryDiscount<%= category._id %>" name="discount" value="<%= category.offer ? category.offer.discount : '' %>" required>
                    <input type="hidden" name="category_id" value="<%= category._id %>">
                    <% if (category.maxCategoryDiscount !== null) { %>
                      <small class="text-muted d-block mt-1">Maximum allowed discount (90% of lowest MRP ₹<%= category.minProductMrp %>): <strong>₹<%= category.maxCategoryDiscount %></strong></small>
                    <% } %>
                    <span id="categoryDiscountBadge<%= category._id %>" class="badge bg-secondary mt-2">Enter discount amount</span>
                    <div id="categoryError<%= category._id %>" class="text-danger mt-2" style="display:none;"></div>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                  <button type="submit" class="btn btn-primary">Save Offer</button>
                </div>
              </form>
            </div>
          </div>
        </div>
        <% }); %>
      </tbody>
    </table>
    </div>
  </div>
  </main>
  </div>
<%- include('./adminLayout/footer') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  <% if (typeof error !== 'undefined' && error) { %>
    Swal.fire({
      icon: 'error',
      title: 'Offer Rejected',
      text: '<%= error %>',
      confirmButtonColor: '#d33'
    });
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    Swal.fire({
      icon: 'success',
      title: 'Success!',
      text: '<%= success %>',
      timer: 2500,
      showConfirmButton: false
    });
  <% } %>

  <% categories.forEach(category => { %>
    (function() {
      var discountInput = document.getElementById('categoryDiscount<%= category._id %>');
      var discountBadge = document.getElementById('categoryDiscountBadge<%= category._id %>');
      var errorDiv = document.getElementById('categoryError<%= category._id %>');
      var form = document.getElementById('categoryOfferForm<%= category._id %>');
      var maxDiscount = <%= category.maxCategoryDiscount !== null ? category.maxCategoryDiscount : 'null' %>;
      var minMrp = <%= category.minProductMrp !== null ? category.minProductMrp : 'null' %>;

      if (discountInput) {
        discountInput.addEventListener('input', function () {
          var discountValue = parseFloat(discountInput.value);
          if (isNaN(discountValue) || discountValue < 0) {
            errorDiv.textContent = "Discount cannot be negative or invalid.";
            errorDiv.style.display = "block";
            discountBadge.textContent = "Invalid Discount";
            discountBadge.className = "badge bg-danger mt-2";
          } else if (maxDiscount !== null && discountValue > maxDiscount) {
            errorDiv.textContent = `Discount (₹${discountValue}) exceeds the maximum 90% discount limit (₹${maxDiscount}) for this category.`;
            errorDiv.style.display = "block";
            discountBadge.textContent = `Exceeds 90% Limit (Max ₹${maxDiscount})`;
            discountBadge.className = "badge bg-danger mt-2";
          } else if (discountValue === 0) {
            errorDiv.style.display = "none";
            discountBadge.textContent = "No Offer (₹0)";
            discountBadge.className = "badge bg-secondary mt-2";
          } else {
            errorDiv.style.display = "none";
            discountBadge.textContent = `Category Discount: ₹${discountValue.toFixed(2)}`;
            discountBadge.className = "badge bg-success mt-2";
          }
        });

        form.addEventListener('submit', function (event) {
          event.preventDefault();
          var discountValue = parseFloat(discountInput.value);

          if (isNaN(discountValue) || discountValue < 0) {
            errorDiv.textContent = "Please enter a valid discount amount.";
            errorDiv.style.display = "block";
            return false;
          }

          if (maxDiscount !== null && discountValue > maxDiscount) {
            errorDiv.textContent = `Discount (₹${discountValue}) exceeds the maximum 90% discount limit (₹${maxDiscount}) for this category.`;
            errorDiv.style.display = "block";
            Swal.fire({
              icon: 'error',
              title: 'Discount Exceeds 90% Limit',
              text: `Discount amount (₹${discountValue}) exceeds maximum 90% discount limit (₹${maxDiscount}) for products in this category.`,
              confirmButtonColor: '#d33'
            });
            return false;
          }

          Swal.fire({
            title: 'Apply Category Offer',
            text: 'Are you sure you want to save this category discount?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#4CAF50',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, save it!',
            cancelButtonText: 'Cancel'
          }).then((result) => {
            if (result.isConfirmed) {
              form.submit();
            }
          });
        });
      }
    })();
  <% }); %>
});

function confirmRemoveOffer(event, categoryId) {
  if (event) event.preventDefault();
  Swal.fire({
    title: 'Are you sure?',
    text: "Do you really want to remove this category offer?",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Yes, remove it!',
    cancelButtonText: 'No, keep it'
  }).then((result) => {
    if (result.isConfirmed) {
      document.getElementById('removeOfferForm' + categoryId).submit();
    }
  });
  return false;
}
</script>
